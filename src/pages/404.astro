---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Scene from "../components/art/Scene.astro";
import StickyNote from "../components/marks/StickyNote.astro";
import { resolveRefs } from "../lib/library";

const quick = await resolveRefs(["toolkit/take-home-salary-calculator", "toolkit/gratuity-calculator", "toolkit/notice-period-calculator", "toolkit/offer-letter"]);
---

<BaseLayout title="Page not found" description="This page isn't in the PeopleCraft library." noindex>
  <section class="wrap nf-wrap">
  <div class="nf">
    <h1 class="display">This page isn't here</h1>
    <p class="lede">
      The link may be old or mistyped. Pages from the previous PeopleCraft site have moved into the handbooks and the toolkit.
    </p>
    <form class="find" action="/search/" method="get" role="search">
      <Icon name="search" size={20} />
      <label for="nf-q" class="visually-hidden">Search the library</label>
      <input id="nf-q" name="q" type="search" placeholder="Search for what you were looking for" />
      <button class="btn" type="submit">Search</button>
    </form>
    <div class="go">
      <a class="btn btn-secondary" href="/">Home</a>
      <a class="btn btn-secondary" href="/start/">Start here</a>
      <a class="btn btn-secondary" href="/handbooks/">Handbooks</a>
      <a class="btn btn-secondary" href="/toolkit/">Toolkit</a>
    </div>
    {
      quick.length > 0 && (
        <div class="quick">
          <p class="small muted">Or jump to a common tool</p>
          <ul>
            {quick.map((q) => (
              <li>
                <a href={q.href}>{q.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <div class="nf-art">
    <Scene name="not-found" />
    <StickyNote color="pink" title="Old bookmark?" tilt={2} class="nf-note">
      <p>Pages from the old single-page site now live in the handbooks and the toolkit. Search for the topic and you'll find it.</p>
    </StickyNote>
  </div>
  </section>
</BaseLayout>

<style>
  .nf-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: 3rem;
    align-items: center;
    padding-block: 3rem var(--section);
  }
  .nf {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    max-width: 48rem;
  }
  .nf-art {
    display: grid;
    gap: 1.5rem;
  }
  .nf-art :global(.nf-note) {
    margin-left: 2rem;
  }
  @media (max-width: 860px) {
    .nf-wrap {
      grid-template-columns: 1fr;
    }
  }
  .find {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.35rem 0.35rem 0.9rem;
    border: 2px solid var(--neel-700);
    border-radius: var(--r-lg);
    color: var(--ink-3);
  }
  .find:focus-within {
    box-shadow: 0 0 0 4px var(--neel-100);
  }
  .find input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    min-height: 2.6rem;
    font-size: var(--fs-md);
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .quick ul {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.25rem;
  }
</style>
