---
/**
 * What changed: dated changes to the rates and rules the library uses, newest first,
 * built from src/data/statutory.ts (see src/lib/changes.ts). RSS: /changes/rss.xml.
 */
import { readFileSync } from "node:fs";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/site/PageHero.astro";
import { breadcrumbLd, chapterUrl, jdUrl, toolUrl } from "../../lib/library";
import { changes, longDate } from "../../lib/changes";

const trail = [
  { name: "Library", href: "/" },
  { name: "What changed", href: "/changes/" }
];

// Pages that show a fact: <Fact id="…" />, fx("…") or {{fact:…}} anywhere in the file.
const [chapters, tools, jds] = await Promise.all([getCollection("handbooks"), getCollection("toolkit"), getCollection("jds")]);
const pages = [
  ...chapters.map((e) => ({ title: e.data.title, href: chapterUrl(e), file: e.filePath })),
  ...tools.map((e) => ({ title: e.data.title, href: toolUrl(e), file: e.filePath })),
  ...jds.map((e) => ({ title: `${e.data.title} JD`, href: jdUrl(e), file: e.filePath }))
].map((p) => ({ ...p, raw: p.file ? readFileSync(p.file, "utf8") : "" }));
const usedBy = (ids: string[]) =>
  pages.filter((p) => ids.some((id) => p.raw.includes(`"${id}"`) || p.raw.includes(`fact:${id}`)));

const list = changes().map((c) => ({ ...c, pages: usedBy(c.facts) }));
---

<BaseLayout
  title="What changed"
  description="Changes to Indian labour law rates and rules used by PeopleCraft's calculators and handbooks, newest first, each with its source. Follow it by RSS."
  jsonLd={breadcrumbLd(Astro.site, trail)}
>
  <PageHero
    title="What changed"
    lede="Changes to the rates and rules this library uses, newest first. They come from the same data file the calculators read, so this list and the calculators always agree."
    trail={trail}
  />

  <div class="wrap-narrow section">
    <p class="feed"><a href="/changes/rss.xml">Follow with RSS</a> in any feed reader to hear about the next change. No sign-up, no email address needed.</p>
    <ol class="log">
      {
        list.map((c) => (
          <li id={c.anchor}>
            <p class="when">
              <time datetime={c.date}>{longDate(c.date)}</time>
            </p>
            <h2>{c.title}</h2>
            {c.detail && <p>{c.detail}</p>}
            <p class="law">
              {c.law}.{" "}
              <a href={c.source.url} rel="noopener" target="_blank">
                {c.source.title}
              </a>
            </p>
            {c.pages.length > 0 && (
              <details>
                <summary>
                  {c.pages.length} {c.pages.length === 1 ? "page uses" : "pages use"} this
                </summary>
                <ul>
                  {c.pages.map((p) => (
                    <li>
                      <a href={p.href}>{p.title}</a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .section {
    display: grid;
    gap: 1.5rem;
    padding-bottom: var(--section);
  }
  .feed {
    color: var(--ink-2);
  }
  .log {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .log > li {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
  }
  .when {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--neel-700);
  }
  h2 {
    font-size: var(--fs-md);
    line-height: 1.3;
  }
  .law {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  details summary {
    cursor: pointer;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  details ul {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    font-size: var(--fs-sm);
  }
</style>
