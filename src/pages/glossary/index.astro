---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/site/PageHero.astro";
import Icon from "../../components/ui/Icon.astro";
import GlossaryPins from "../../components/desk/GlossaryPins.astro";
import { allTerms, allChapters, allTools, allJds, resolveRefs, breadcrumbLd } from "../../lib/library";

const terms = await allTerms();
const withLinks = await Promise.all(terms.map(async (t) => ({ t, links: await resolveRefs(t.data.related) })));
const termName = new Map(terms.map((t) => [t.id, t.data.term]));
// The terms the rest of the library leans on most: counted from every chapter's, tool's and JD's links.
const [chs, tls, jds] = await Promise.all([allChapters(), allTools(), allJds()]);
const refCount = new Map<string, number>();
for (const e of [...chs, ...tls, ...jds]) for (const r of e.data.related) if (r.startsWith("glossary/")) refCount.set(r.slice(9), (refCount.get(r.slice(9)) ?? 0) + 1);
const mostUsed = terms
  .filter((t) => refCount.has(t.id))
  .sort((a, b) => refCount.get(b.id)! - refCount.get(a.id)! || a.data.term.localeCompare(b.data.term))
  .slice(0, 3);
// A–Z first, then terms that start with a number ("#"), matching the jump bar.
const letters = Array.from(new Set(terms.map((t) => t.data.term[0].toUpperCase().replace(/[^A-Z]/, "#")))).sort(
  (a, b) => Number(a === "#") - Number(b === "#") || a.localeCompare(b)
);
const alphabet = [..."ABCDEFGHIJKLMNOPQRSTUVWXYZ", ...(letters.includes("#") ? ["#"] : [])];
const letterId = (l: string) => `letter-${l === "#" ? "num" : l}`;
const trail = [
  { name: "Library", href: "/" },
  { name: "Glossary", href: "/glossary/" }
];
const ld = [
  breadcrumbLd(Astro.site, trail),
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "PeopleCraft HR glossary for India",
    url: new URL("/glossary/", Astro.site).toString(),
    hasDefinedTerm: terms.map((t) => ({
      "@type": "DefinedTerm",
      name: t.data.term,
      alternateName: t.data.expansion,
      description: t.data.short,
      url: new URL(`/glossary/#${t.id}`, Astro.site).toString()
    }))
  }
];
---

<BaseLayout title="HR glossary for India" description={`${terms.length} Indian workplace and HR terms explained in one plain sentence each: CTC, F&F, LWP, UAN, comp-off, POSH and more, with links to go deeper.`} jsonLd={ld} image="/og/glossary.png">
  <PageHero title="Glossary" lede={`${terms.length} workplace ${terms.length === 1 ? "term" : "terms"} in plain words. Each links to the chapter or tool that goes deeper.`} trail={trail}>
    <label class="find" data-pagefind-ignore>
      <Icon name="search" size={20} />
      <span class="visually-hidden">Filter the glossary</span>
      <input type="search" placeholder="Find a term, e.g. gratuity or LWP" data-gl-filter autocomplete="off" />
    </label>
    {
      mostUsed.length > 0 && (
        <div slot="aside" class="most">
          <p class="glance-label">The terms the library uses most</p>
          <ol class="catalogue">
            {mostUsed.map((t, i) => (
              <li style={`--i:${i}`}>
                <a href={`#${t.id}`} class="cat">
                  <span class="cat-head">
                    <span class="mt">{t.data.term}</span>
                    <span class="mn" title="Pages that link to this term">{refCount.get(t.id)} pages</span>
                  </span>
                  {t.data.expansion && <span class="mx">{t.data.expansion}</span>}
                  <span class="md">{t.data.short}</span>
                  <span class="hole" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </PageHero>

  <div class="bar" data-pagefind-ignore>
    <div class="bar-in">
      <span class="bar-l" aria-hidden="true">A to Z</span>
      <nav class="az" aria-label="Jump to letter">
        {alphabet.map((l) => (letters.includes(l) ? <a href={`#${letterId(l)}`}>{l}</a> : <span aria-hidden="true">{l}</span>))}
      </nav>
    </div>
  </div>

  <div class="gl-layout">
  <nav class="gl-index" aria-label="All terms" data-pagefind-ignore>
    {
      letters.map((l) => (
        <div class="gi-group">
          <p class="gi-l" aria-hidden="true">{l}</p>
          <ul>
            {terms
              .filter((t) => t.data.term[0].toUpperCase().replace(/[^A-Z]/, "#") === l)
              .map((t) => (
                <li>
                  <a href={`#${t.id}`} data-gi={t.id}>
                    {t.data.term}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <div class="list" data-pagefind-body data-pagefind-filter="section:Glossary" data-pagefind-meta="kind:Glossary">
    {
      letters.map((l) => (
        <section class="letter" id={letterId(l)} data-gl-letter>
          <h2 class="lh">{l}</h2>
          <div class="terms">
            {withLinks
              .filter(({ t }) => (t.data.term[0].toUpperCase().replace(/[^A-Z]/, "#")) === l)
              .map(({ t, links }) => (
                <div class="term" data-gl-term data-text={`${t.data.term} ${t.data.expansion ?? ""} ${t.data.aliases.join(" ")} ${t.data.short}`.toLowerCase()}>
                  <div class="tk">
                    <h3 id={t.id}>
                      <a class="anchor" href={`#${t.id}`}>
                        {t.data.term}
                      </a>
                    </h3>
                    {t.data.expansion && <span class="exp">{t.data.expansion}</span>}
                  </div>
                  <div class="tdef">
                    <p class="short">{t.data.short}</p>
                    {t.data.detail && <p class="detail">{t.data.detail}</p>}
                    {(links.length > 0 || t.data.seeAlso.length > 0) && (
                      <p class="more" data-pagefind-ignore>
                        {links.map((ln) => (
                          <a href={ln.href} class="go">
                            {ln.title}
                          </a>
                        ))}
                        {t.data.seeAlso
                          .filter((s) => termName.has(s))
                          .map((s) => (
                            <a href={`#${s}`} class="see">
                              See {termName.get(s)}
                            </a>
                          ))}
                      </p>
                    )}
                  </div>
                </div>
              ))}
          </div>
        </section>
      ))
    }
    <p class="muted" data-gl-none hidden>No terms match that filter.</p>
  </div>
  </div>
  <GlossaryPins />
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-gl-filter]");
  const termsEl = Array.from(document.querySelectorAll<HTMLElement>("[data-gl-term]"));
  const lettersEl = Array.from(document.querySelectorAll<HTMLElement>("[data-gl-letter]"));
  const none = document.querySelector<HTMLElement>("[data-gl-none]");
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    termsEl.forEach((t) => {
      const ok = !q || t.dataset.text!.includes(q);
      t.hidden = !ok;
      if (ok) n++;
    });
    lettersEl.forEach((l) => (l.hidden = !l.querySelector("[data-gl-term]:not([hidden])")));
    if (none) none.hidden = n > 0;
  });
  // Highlight a term reached by a link.
  const mark = () => {
    document.querySelectorAll(".term.target").forEach((e) => e.classList.remove("target"));
    if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest(".term")?.classList.add("target");
  };
  window.addEventListener("hashchange", mark);
  mark();
  // Keep the index pane in step: the term being read is marked, and filtering hides index entries too.
  const index = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-gi]").forEach((a) => index.set(a.dataset.gi!, a));
  const pane = document.querySelector<HTMLElement>(".gl-index");
  if (pane && "IntersectionObserver" in window && getComputedStyle(pane).display !== "none") {
    let cur = "";
    const io = new IntersectionObserver(
      (entries) => {
        const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!vis.length) return;
        const id = (vis[0].target as HTMLElement).id;
        if (id === cur) return;
        index.get(cur)?.removeAttribute("aria-current");
        const a = index.get(id);
        if (a) {
          a.setAttribute("aria-current", "location");
          const top = a.offsetTop - pane.clientHeight / 3;
          pane.scrollTo({ top, behavior: "auto" });
        }
        cur = id;
      },
      { rootMargin: "-25% 0px -60% 0px" }
    );
    document.querySelectorAll<HTMLElement>(".term h3[id]").forEach((h) => io.observe(h));
  }
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    termsEl.forEach((t) => {
      const id = t.querySelector("h3")?.id;
      const a = id ? index.get(id) : undefined;
      if (a) a.parentElement!.hidden = t.hidden;
    });
    document.querySelectorAll<HTMLElement>(".gi-group").forEach((g) => (g.hidden = !g.querySelector("li:not([hidden])")));
    void q;
  });
</script>

<style>
  /* Library catalogue cards: ruled card stock, a headword, a punched hole for the drawer rod.
     Fanned slightly, like cards pulled from the drawer; a card squares up when you point at it. */
  .catalogue {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
  }
  .catalogue li {
    position: relative;
    z-index: calc(3 - var(--i));
  }
  .catalogue li + li {
    margin-top: -0.6rem;
  }
  .cat {
    --rot: calc((var(--i) - 1) * 1.1deg);
    position: relative;
    display: grid;
    gap: 0;
    padding: 0.75rem 1.1rem 1.75rem;
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
    background-color: var(--paper);
    /* Ruled lines start under the headword rule. */
    background-image:
      linear-gradient(var(--haldi-500), var(--haldi-500)),
      repeating-linear-gradient(180deg, transparent 0 1.45rem, rgb(76 86 190 / 0.13) 1.45rem calc(1.45rem + 1px));
    background-size:
      100% 2px,
      100% calc(100% - 2.6rem);
    background-position:
      0 2.45rem,
      0 2.6rem;
    background-repeat: no-repeat;
    box-shadow:
      0 0 0 1px rgb(17 20 58 / 0.07),
      1.5px 2px 0 rgb(17 20 58 / 0.08),
      4px 10px 18px -10px rgb(17 20 58 / 0.25);
    transform: rotate(var(--rot)) translateX(calc(var(--i) * 0.5rem));
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease);
  }
  .cat:hover,
  .cat:focus-visible {
    z-index: 4;
    transform: rotate(0deg) translateX(calc(var(--i) * 0.5rem)) translateY(-4px);
    box-shadow:
      0 0 0 1px rgb(59 68 166 / 0.3),
      3px 6px 0 rgb(17 20 58 / 0.05),
      6px 18px 28px -12px rgb(17 20 58 / 0.35);
  }
  .catalogue li:has(.cat:hover),
  .catalogue li:has(.cat:focus-visible) {
    z-index: 5;
  }
  .cat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    height: 1.7rem;
    margin-bottom: 0.15rem;
  }
  .mt {
    font-weight: 780;
    font-size: var(--fs-lg);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  /* Where a call number would be: how many pages lean on this term. */
  .mn {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--neel-700);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .mx {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
    line-height: 1.45rem;
  }
  .md {
    font-size: var(--fs-sm);
    line-height: 1.45rem;
    color: var(--ink-2);
  }
  .hole {
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    margin-left: -0.35rem;
    border-radius: 50%;
    background: var(--canvas);
    box-shadow: inset 1px 1.5px 2px rgb(17 20 58 / 0.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .cat {
      transition: none;
    }
  }
  .gl-layout {
    width: min(100% - 2 * var(--gutter), var(--wrap));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 13rem minmax(0, 52rem);
    justify-content: center;
    gap: 3rem;
  }
  .gl-index {
    position: sticky;
    top: calc(var(--header-h) + 5.5rem);
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 7rem);
    overflow-y: auto;
    padding: 1.5rem 0.5rem 2rem 0;
    font-size: var(--fs-sm);
    scrollbar-width: thin;
  }
  .gi-group + .gi-group {
    margin-top: 0.9rem;
  }
  .gi-l {
    font-weight: 750;
    color: var(--neel-400);
    font-size: var(--fs-xs);
  }
  .gl-index ul {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .gl-index a {
    display: block;
    margin-left: -2px;
    padding: 0.18rem 0 0.18rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.3;
  }
  .gl-index a:hover {
    color: var(--ink);
  }
  .gl-index a[aria-current] {
    color: var(--ink);
    font-weight: 650;
    border-left-color: var(--accent);
  }
  @media (max-width: 1100px) {
    .gl-layout {
      grid-template-columns: minmax(0, 52rem);
    }
    .gl-index {
      display: none;
    }
  }
  .bar-in {
    width: min(100% - 2 * var(--gutter), var(--wrap));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 13rem minmax(0, 52rem);
    justify-content: center;
    gap: 3rem;
    align-items: center;
  }
  .bar-l {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--ink-3);
  }
  @media (max-width: 1100px) {
    .bar-in {
      grid-template-columns: minmax(0, 52rem);
    }
    .bar-l {
      display: none;
    }
  }
  .bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding-block: 0.75rem;
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .find {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding: 0 1rem;
    min-height: 3.25rem;
    width: min(100%, 30rem);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink-3);
    font-size: var(--fs-md);
    box-shadow: 1px 1.5px 0 rgb(17 20 58 / 0.06);
  }
  .find:focus-within {
    border-color: var(--primary);
  }
  .find:focus-within {
    border-color: var(--primary);
  }
  .find input {
    flex: 1;
    border: 0;
    outline: none;
    background: transparent;
    min-height: 2.4rem;
  }
  .az {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .az a,
  .az span {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 2rem;
    border-radius: 6px;
    color: var(--ink-2);
    font-weight: 620;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .az span {
    color: var(--line-strong);
    font-weight: 500;
  }
  .az a:hover {
    background: var(--neel-50);
    color: var(--primary);
  }
  .list {
    padding-block: 2rem var(--section);
    display: grid;
    gap: 2rem;
  }
  .letter {
    scroll-margin-top: calc(var(--header-h) + 5rem);
  }
  .lh {
    font-size: var(--fs-2xl);
    color: var(--neel-400);
    font-stretch: 106%;
    border-bottom: 2px solid var(--neel-700);
    padding-bottom: 0.25rem;
  }
  .term {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr;
    gap: 0.5rem 1.5rem;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--line);
    border-radius: 6px;
    transition: background-color 400ms;
  }
  .term.target {
    background: var(--haldi-50);
  }
  .tk {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }
  .tk h3 {
    font-size: var(--fs-md);
    line-height: 1.25;
    scroll-margin-top: calc(var(--header-h) + 6rem);
  }
  .anchor {
    font-weight: 680;
    color: var(--ink);
    text-decoration: none;
  }
  .anchor:hover {
    color: var(--primary);
  }
  .exp {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .tdef {
    min-width: 0;
  }
  .short {
    font-weight: 500;
  }
  .detail {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .more {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .go,
  .see {
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .go {
    background: var(--neel-50);
    color: var(--neel-700);
  }
  .see {
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .bar {
      position: static;
    }
    .term {
      grid-template-columns: 1fr;
    }
  }
</style>
