---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/site/PageHero.astro";
import Icon from "../../components/ui/Icon.astro";
import { AUDIENCES, AUDIENCE_INFO, type Audience } from "../../data/taxonomy";
import { PATHS } from "../../data/paths";
import { resolveRefs, breadcrumbLd } from "../../lib/library";
import type { IconName } from "../../lib/icons";

export function getStaticPaths() {
  return AUDIENCES.map((audience) => ({ params: { audience } }));
}

const audience = Astro.params.audience as Audience;
const info = AUDIENCE_INFO[audience];
// "For HR professionals", "For founders and small businesses": keep acronyms, lower-case ordinary words.
const forLabel = `For ${/^[A-Z]{2}/.test(info.label) ? info.label : info.label[0].toLowerCase() + info.label.slice(1)}`;
const path = PATHS[audience];
const groups = (await Promise.all(path.groups.map(async (g) => ({ ...g, links: await resolveRefs(g.refs) })))).filter((g) => g.links.length > 0);
const others = AUDIENCES.filter((a) => a !== audience);
const trail = [
  { name: "Library", href: "/" },
  { name: "Start here", href: "/start/" },
  { name: info.label, href: info.path }
];
const ld = [
  breadcrumbLd(Astro.site, trail),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `PeopleCraft reading path ${forLabel.replace(/^For/, "for")}`,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    itemListElement: groups
      .flatMap((g) => g.links)
      .map((l, i) => ({ "@type": "ListItem", position: i + 1, name: l.title, url: new URL(l.href, Astro.site).toString() }))
  }
];
---

<BaseLayout title={`Start here: ${info.label}`} description={`${path.intro.slice(0, 150)}`} jsonLd={ld}>
  <PageHero title={forLabel} lede={path.intro} trail={trail} />

  <div class="wrap section">
    <ol class="path">
      {
        groups.map((g, i) => (
          <li class="step">
            <div class="knot" aria-hidden="true">
              {i + 1}
            </div>
            <div class="step-body">
              <h2>{g.title}</h2>
              <p class="why">{g.why}</p>
              <ul class="links">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} class="link-card">
                      <span class="lk">
                        <Icon name={l.icon as IconName} size={16} />
                        {l.kind}
                      </span>
                      <span class="lt">{l.title}</span>
                      {l.description && <span class="ld">{l.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
    {groups.length === 0 && <p class="muted">This path is being written. Meanwhile, browse the <a href="/handbooks/">handbooks</a> or the <a href="/toolkit/">toolkit</a>.</p>}
  </div>

  <aside class="band others" aria-labelledby="others-h">
    <div class="wrap">
      <h2 id="others-h">Other paths</h2>
      <ul>
        {
          others.map((a) => (
            <li>
              <a href={AUDIENCE_INFO[a].path} class="other">
                <Icon name={AUDIENCE_INFO[a].icon as IconName} size={20} />
                <span>
                  <strong>{AUDIENCE_INFO[a].label}</strong>
                  <span class="small muted">{AUDIENCE_INFO[a].blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </aside>
</BaseLayout>

<style>
  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 62rem;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2.75rem;
  }
  /* The thread between knots. */
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1.5rem - 1.5px);
    top: 3rem;
    bottom: 0;
    width: 3px;
    background: repeating-linear-gradient(180deg, var(--neel-300) 0 10px, transparent 10px 16px);
  }
  .knot {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--neel-700);
    color: #fff;
    font-weight: 700;
    font-size: var(--fs-md);
    box-shadow: 0 0 0 5px var(--paper), 0 0 0 7px var(--haldi-300);
  }
  .step-body {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.45rem;
  }
  .step-body h2 {
    font-size: var(--fs-lg);
  }
  .why {
    color: var(--ink-2);
    max-width: 60ch;
  }
  .links {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.6rem;
  }
  .link-card {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.9rem 1rem 1rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms, background-color 150ms;
  }
  .link-card:hover {
    border-color: var(--neel-300);
    background: var(--canvas);
  }
  .lk {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  .lt {
    font-weight: 650;
    line-height: 1.3;
  }
  .ld {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .others {
    padding-block: 3rem var(--section);
  }
  .others h2 {
    font-size: var(--fs-lg);
    margin-bottom: 1rem;
  }
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
  }
  .other {
    height: 100%;
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .other :global(svg) {
    color: var(--neel-600);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .other > span {
    display: grid;
    gap: 0.2rem;
  }
  .other:hover {
    border-color: var(--neel-300);
  }
  @media (max-width: 640px) {
    .step {
      grid-template-columns: 2.25rem 1fr;
      gap: 0.9rem;
    }
    .knot {
      width: 2.25rem;
      height: 2.25rem;
      font-size: var(--fs-base);
    }
    .step:not(:last-child)::before {
      left: calc(1.125rem - 1.5px);
      top: 2.25rem;
    }
  }
</style>
