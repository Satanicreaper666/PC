---
/**
 * A plan or guide as a timeline of its own section headings, in order.
 * "Days 1 to 30: listen and learn" shows the lead in bold and the rest under it.
 * Up to four parts run across; more run down, with the count beside them.
 */
import type { PlanPart } from "./glance";
interface Props {
  parts: PlanPart[];
}
const { parts } = Astro.props;
const across = parts.length <= 4;
const MAX = 6;
const shown = across ? parts : parts.slice(0, MAX);
const more = parts.length - shown.length;
const count = `${parts.length} ${parts.length === 1 ? "part" : "parts"}`;
/** Rows are taller when any part has a lead and a rest. */
const row = shown.some((p) => p.rest) ? 2.9 : 2.2;
---

<div class:list={["pl", across ? "across" : "down"]} style={`--n:${shown.length};--row:${row}rem`}>
  <p class="glance-label" id="glance-kind">Its parts, in order</p>
  <div class="cols">
    <div>
      <ol class="line" aria-labelledby="glance-kind">
        {
          shown.map((p, i) => (
            <li>
              <span class="k" aria-hidden="true">
                {i + 1}
              </span>
              <span class="t">
                <span class="lead">{p.lead}</span>
                {p.rest && (
                  <>
                    <span class="visually-hidden">: </span>
                    <span class="rest">{p.rest}</span>
                  </>
                )}
              </span>
            </li>
          ))
        }
      </ol>
      {more > 0 && <p class="more">+{more} more {more === 1 ? "part" : "parts"}</p>}
    </div>
    {
      !across && (
        <div class="total">
          <p>
            <strong class="num">{parts.length}</strong> <span class="unit">{parts.length === 1 ? "part" : "parts"}</span>
          </p>
          <p class="note">Read them in order and adapt them to your organisation.</p>
        </div>
      )
    }
  </div>
  {across && <p class="facts"><strong>{count}</strong> to read and adapt</p>}
</div>

<style>
  .pl {
    --col: 2.25rem;
    --kd: 1.6rem;
  }
  .glance-label {
    margin-bottom: 0.5rem;
  }
  .line {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .line::before {
    content: "";
    position: absolute;
    border-radius: 3px;
    background: var(--neel-200);
  }
  .k {
    display: grid;
    place-items: center;
    width: var(--kd);
    height: var(--kd);
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--neel-600);
    box-shadow: 0 0 0 3px var(--canvas);
    color: var(--neel-800);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .t {
    display: grid;
    gap: 0.1rem;
    line-height: 1.3;
  }
  .lead {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--ink);
  }
  .rest {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }

  /* Across: knots on one thread, the words under each knot. */
  .across .line {
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: 0.75rem;
  }
  .across .line::before {
    left: calc((100% - (var(--n) - 1) * 0.75rem) / var(--n) / 2);
    right: calc((100% - (var(--n) - 1) * 0.75rem) / var(--n) / 2);
    top: calc(var(--kd) / 2 - 3px);
    height: 6px;
  }
  .across li {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.5rem;
    text-align: center;
  }
  .across .t {
    justify-items: center;
    text-wrap: balance;
  }

  /* Down: one knot per row, the count beside the thread. */
  .down .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9.5rem;
    gap: 1.25rem;
    align-items: center;
  }
  .down .line::before {
    left: calc(var(--col) / 2 - 3px);
    top: calc(var(--row) / 2);
    bottom: calc(var(--row) / 2);
    width: 6px;
  }
  .down li {
    position: relative;
    display: grid;
    grid-template-columns: var(--col) minmax(0, 1fr);
    align-items: center;
    column-gap: 0.6rem;
    min-height: var(--row);
  }
  .down .k {
    justify-self: center;
  }
  .more {
    margin-top: 0.1rem;
    padding-left: calc(var(--col) + 0.6rem);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  .total {
    padding-left: 1.1rem;
    border-left: 1px solid var(--line-strong);
  }
  .num {
    font-size: var(--fs-xl);
    font-weight: 700;
    font-stretch: 104%;
    line-height: 1;
    color: var(--ink);
  }
  .unit {
    font-size: var(--fs-md);
    font-weight: 620;
    color: var(--ink);
  }
  .note {
    margin-top: 0.6rem;
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: var(--ink-3);
  }
  .facts {
    margin-top: 1rem;
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .facts strong {
    color: var(--ink);
    font-weight: 700;
  }
</style>
