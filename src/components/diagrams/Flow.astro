---
import "./desk.css";
/**
 * A process: steps joined by arrows, optionally ending in a fork.
 * <Flow
 *   steps={[{ title: "Employee applies", who: "Employee" }, { title: "Manager reviews", detail: "Within 2 working days" }]}
 *   outcomes={[{ title: "Approved", detail: "Balance updated", tone: "good" }, { title: "Declined", detail: "Reason shared", tone: "bad" }]}
 * />
 * On the desk: each step is an index card with who does it written in its header, the arrows
 * are drawn in pen, and each outcome is a sticky note: green when it goes well, pink for a risk,
 * yellow otherwise. The words carry the meaning; the stationery repeats it.
 */
interface Step {
  title: string;
  detail?: string;
  who?: string;
}
interface Outcome {
  title: string;
  detail?: string;
  tone?: "good" | "bad" | "neutral";
}
interface Props {
  steps: Step[];
  outcomes?: Outcome[];
  label?: string;
}
const { steps, outcomes = [], label } = Astro.props;
const forked = outcomes.length > 0;
const note = { good: "dk-green", bad: "dk-pink", neutral: "dk-yellow" } as const;
const tilt = [-0.6, 0.45, -0.3, 0.55];
// Handwriting is for short labels only (docs/ART-DIRECTION.md): six words or fewer.
const short = (s: string) => s.trim().split(/\s+/).length <= 6;
// A pen arrow: a slightly uneven shaft, then the open head as a second stroke.
const SHAFT = "M2.5 9.6c5.2-1.1 10.6-1.4 16.1-.8 4.4.5 8.6.4 12.8-.4";
const HEAD = "M26.6 4.2c2.3 1.4 4.5 2.9 6.6 4.7-2 1.6-4.2 3.2-6.3 4.9";
---

<div class:list={["flow", { forked, vertical: steps.length > 4 }]} style={`--n:${outcomes.length || 1}`} data-draw role="group" aria-label={label}>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class:list={["step", "dk-card", s.who ? "has-who" : "dk-index"]} style={`--i:${i}`}>
          {s.who && <span class:list={["who", { hand: short(s.who) }]}>{s.who}</span>}
          <span class="title">{s.title}</span>
          {s.detail && <span class="detail" set:html={s.detail} />}
          {i < steps.length - 1 ? (
            <svg class="pen arrow" viewBox="0 0 36 18" aria-hidden="true" data-mark>
              <path class="pen-stroke" pathLength="1" d={SHAFT} />
              <path class="pen-stroke" pathLength="1" d={HEAD} />
            </svg>
          ) : (
            forked && (
              <svg class="pen to-fork" viewBox="0 0 24 12" aria-hidden="true" data-mark>
                <path class="pen-stroke" pathLength="1" d="M1 6.4c7-.9 14.2-.7 22-.2" />
              </svg>
            )
          )}
        </li>
      ))
    }
  </ol>
  {
    forked && (
      <div class="fork">
        <span class="visually-hidden">Possible outcomes:</span>
        <svg class="pen trunk" viewBox="0 0 4 100" preserveAspectRatio="none" aria-hidden="true" data-mark>
          <path class="pen-stroke" pathLength="1" d="M2 0c-.7 31 .7 64 0 100" />
        </svg>
        <ul class="outcomes">
          {outcomes.map((o, i) => (
            <li class="outcome" style={`--i:${steps.length + i}`}>
              <svg class="pen arrow" viewBox="0 0 36 18" aria-hidden="true" data-mark>
                <path class="pen-stroke" pathLength="1" d={SHAFT} />
                <path class="pen-stroke" pathLength="1" d={HEAD} />
              </svg>
              <div class:list={["note", "dk-sticky", note[o.tone ?? "neutral"]]} style={`--dk-tilt:${tilt[i % tilt.length]}deg`}>
                <span class="title">{o.title}</span>
                {o.detail && <span class="detail" set:html={o.detail} />}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .flow {
    --gap: 1.6rem;
    --fork-gap: 1.25rem;
    display: grid;
    gap: var(--fork-gap);
    align-items: center;
  }
  .flow.forked {
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.42fr);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0.2rem 0 0.5rem;
    display: flex;
    align-items: stretch;
    gap: var(--gap);
  }
  /* An index card. Who does the step is written in pen in the card's header. */
  .step {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: 0.85rem 0.9rem 0.9rem;
  }
  .step.has-who {
    padding-top: 0.4rem;
  }
  /* No one named: the card's header band is left blank above its red rule. */
  .step.dk-index {
    --dk-rule: 0.55rem;
    padding-top: 1rem;
  }
  .who {
    display: block;
    margin: 0 -0.9rem 0.35rem;
    padding: 0 0.9rem 0.15rem;
    border-bottom: 1px solid rgb(214 69 80 / 0.5);
    font-size: var(--fs-xs);
    font-weight: 620;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .who.hand {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--pen-ink);
  }
  .title {
    font-weight: 640;
    font-size: var(--fs-sm);
    line-height: 1.3;
  }
  .detail {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.4;
  }
  /* Pen arrows: drawn once when seen (data-mark), sitting in the gap between cards. */
  .arrow,
  .to-fork {
    position: absolute;
    top: 50%;
    width: 1.4rem;
    height: 0.7rem;
    stroke-width: 3;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .step .arrow {
    right: calc(-1 * var(--gap) + 0.1rem);
  }
  .to-fork {
    right: calc(-1 * var(--fork-gap));
    width: var(--fork-gap);
    stroke-width: 2.4;
  }
  /* The fork: a pen line down the left of the outcomes, with an arrow into each note. */
  .fork {
    position: relative;
    padding-left: 1.6rem;
  }
  .trunk {
    position: absolute;
    left: -2px;
    top: calc(50% / var(--n));
    width: 4px;
    height: calc(100% - 100% / var(--n));
    stroke-width: 2;
    pointer-events: none;
  }
  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-rows: 1fr;
  }
  .outcome {
    position: relative;
    display: grid;
    padding: 0.4rem 0;
  }
  .outcome .arrow {
    left: -1.5rem;
  }
  .note {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem 0.8rem;
  }

  :global(html.js-anim) .flow:not(.draw):not(.drawn) :is(.step, .outcome) {
    opacity: 0;
    transform: translateY(8px);
  }
  .flow:global(.draw) :is(.step, .outcome) {
    animation: fl-in 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i) * 0.14s);
  }
  @keyframes fl-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Phones, and five or more steps: the cards stack, and the arrows point down a left-hand line. */
  @media (max-width: 760px) {
    .flow.forked {
      grid-template-columns: 1fr;
    }
    .flow {
      --fork-gap: var(--gap);
    }
    .steps {
      flex-direction: column;
      padding-bottom: 0;
    }
    .step .arrow {
      right: auto;
      top: auto;
      left: 0.8rem;
      bottom: calc(-1 * var(--gap) / 2 - 0.35rem);
      transform: rotate(90deg);
    }
    .to-fork {
      display: none;
    }
    .fork {
      padding-left: 3.1rem;
    }
    .trunk {
      left: calc(1.5rem - 2px);
      top: calc(-1 * var(--gap));
      height: calc(var(--gap) + 100% - 50% / var(--n));
    }
  }
  .flow.vertical {
    --fork-gap: var(--gap);
  }
  .flow.vertical.forked {
    grid-template-columns: 1fr;
  }
  .flow.vertical .steps {
    flex-direction: column;
    padding-bottom: 0;
  }
  .flow.vertical .step .arrow {
    right: auto;
    top: auto;
    left: 0.8rem;
    bottom: calc(-1 * var(--gap) / 2 - 0.35rem);
    transform: rotate(90deg);
  }
  .flow.vertical .to-fork {
    display: none;
  }
  .flow.vertical .fork {
    padding-left: 3.1rem;
  }
  .flow.vertical .trunk {
    left: calc(1.5rem - 2px);
    top: calc(-1 * var(--gap));
    height: calc(var(--gap) + 100% - 50% / var(--n));
  }
  /* Printed: every card is on the page, whether or not it was scrolled to. */
  @media print {
    .flow :is(.step, .outcome) {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
