---
import "./desk.css";
/**
 * A repeating process, e.g. the yearly investment-declaration cycle or a performance cycle.
 * <Cycle center="Every financial year" items={[{ title: "April", note: "Collect declarations" }, …]} />
 * A ring on wide screens; a numbered list that loops back on phones.
 *
 * On the desk: the stages are paper cards placed round a circle sketched in pencil, with pen
 * arrowheads showing the direction, and what repeats is written in pen in the middle.
 */
interface Props {
  items: { title: string; note?: string }[];
  center?: string;
  label?: string;
}
const { items, center, label } = Astro.props;
const n = items.length;
const R = 150;
const pts = items.map((_, i) => {
  const a = (i / n) * Math.PI * 2 - Math.PI / 2;
  return { x: 200 + Math.cos(a) * R, y: 200 + Math.sin(a) * R, a };
});
// A circle sketched by hand: the radius wanders a little and the line runs past where it
// started, ending under the first card. Same drawing for the same number of stages.
const wander = (t: number, k = 0) => R + 2.1 * Math.sin(3 * t + 0.7 + k) + 1.3 * Math.sin(5 * t + 1.9 + k);
function sketch(start: number, sweep: number, drift: number, k = 0): string {
  const steps = 22;
  const p = Array.from({ length: steps + 1 }, (_, i) => {
    const t = start + (sweep * i) / steps;
    const r = wander(t, k) + (drift * i) / steps;
    return [200 + Math.cos(t) * r, 200 + Math.sin(t) * r];
  });
  const f = (v: number) => v.toFixed(1);
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  for (let i = 0; i < steps; i++) {
    const p0 = p[Math.max(0, i - 1)], p1 = p[i], p2 = p[i + 1], p3 = p[Math.min(steps, i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
}
const ring = sketch(-Math.PI / 2 - 0.42, Math.PI * 2 + 0.62, 3.2);
const ghost = sketch(-Math.PI / 2 - 0.2, Math.PI * 2 + 0.3, 1.1, 0.8);
// A pen arrowhead halfway between each stage and the next, pointing the way round (clockwise).
const heads = pts.map((p) => {
  const m = p.a + Math.PI / n;
  const r = wander(m);
  const tip = [200 + Math.cos(m) * r - Math.sin(m) * 5, 200 + Math.sin(m) * r + Math.cos(m) * 5];
  const arm = (deg: number) => {
    const t = Math.atan2(Math.cos(m), -Math.sin(m)) + Math.PI + (deg * Math.PI) / 180;
    return [tip[0] + Math.cos(t) * 12, tip[1] + Math.sin(t) * 12];
  };
  const [a1, a2] = [arm(30), arm(-30)];
  const f = (v: number) => v.toFixed(1);
  return `M${f(a1[0])} ${f(a1[1])}L${f(tip[0])} ${f(tip[1])}L${f(a2[0])} ${f(a2[1])}`;
});
// Handwriting is for short labels only (docs/ART-DIRECTION.md): six words or fewer.
const handCenter = !!center && center.trim().split(/\s+/).length <= 6;
const RINGS = ["M13 7C22 3 35 9 35 20s-9 16-17 15S5 28 5 20C6 12 12 7 21 6", "M27 6C17 2 5 9 5 21s10 16 18 15 13-8 12-17C34 11 28 6 20 6"];
---

<div class="cy" data-draw role="group" aria-label={label ?? center ?? "Cycle"}>
  <div class="ring" aria-hidden="true">
    <svg viewBox="0 0 400 400" class="ring-svg pen" data-mark>
      <path d={ghost} class="pencil-ghost" />
      <path d={ring} class="pen-stroke pencil-line" pathLength="1" />
      {heads.map((d) => <path d={d} class="pen-stroke head" pathLength="1" />)}
    </svg>
    {
      pts.map((p, i) => (
        <div class="node dk-card" style={`left:${(p.x / 400) * 100}%;top:${(p.y / 400) * 100}%;--i:${i}`}>
          <span class="num">
            <svg class="num-ring" viewBox="0 0 40 40">
              <path d={RINGS[i % 2]} />
            </svg>
            <span class="n">{i + 1}</span>
          </span>
          <span class="t">{items[i].title}</span>
          {items[i].note && <span class="nt">{items[i].note}</span>}
        </div>
      ))
    }
    {center && <p class:list={["center", { hand: handCenter }]}>{center}</p>}
  </div>
  <ol class="list">
    {
      items.map((it, i) => (
        <li>
          <span class="num" aria-hidden="true">
            <svg class="num-ring" viewBox="0 0 40 40">
              <path d={RINGS[i % 2]} />
            </svg>
            <span class="n">{i + 1}</span>
          </span>
          <span class="t">{it.title}</span>
          {it.note && <span class="nt">{it.note}</span>}
        </li>
      ))
    }
    <li class="loop" aria-hidden="true">
      <svg class="pen loop-arrow" viewBox="0 0 28 28" data-mark>
        <path class="pen-stroke" pathLength="1" d="M20 25c-9 .4-15-3.6-15.6-10.4C3.8 8 8.6 3.6 15.4 3.4" />
        <path class="pen-stroke" pathLength="1" d="M11.2.6c1.6 1 3 1.8 4.4 2.8-1.2 1.3-2.4 2.6-3.6 4" />
      </svg>
      <span class="hand">and back to step 1</span>
    </li>
  </ol>
</div>

<style>
  .cy {
    container-type: inline-size;
  }
  .ring {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The circle, sketched in pencil; the arrowheads are pen. */
  .pencil-line {
    stroke: #8d91a2;
    stroke-width: 1.7;
  }
  .pencil-ghost {
    fill: none;
    stroke: #8d91a2;
    stroke-width: 0.9;
    opacity: 0.4;
  }
  .head {
    stroke: var(--pen-ink);
    stroke-width: 2;
  }
  :global(html.js-anim) .ring-svg:not(:global(.drawn)) .pencil-ghost {
    opacity: 0;
  }
  .ring-svg .pencil-ghost {
    transition: opacity 600ms 400ms;
  }
  /* Sketch the circle first, then add the arrowheads (beats the global "+ .pen-stroke" delay). */
  .cy .ring-svg :global(path.pen-stroke.pencil-line) {
    transition-duration: 1300ms;
  }
  .cy .ring-svg :global(path.pen-stroke.head) {
    transition-delay: 900ms;
  }
  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 9.5rem;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.15rem;
    padding: 0.45rem 0.55rem 0.6rem;
  }
  /* The stage number, written in pen and circled by hand, as in the numbered steps. */
  .num {
    position: relative;
    width: 1.85rem;
    height: 1.85rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .num-ring {
    position: absolute;
    inset: -0.1rem;
    width: calc(100% + 0.2rem);
    max-width: none;
    height: calc(100% + 0.2rem);
    fill: none;
    stroke: var(--pen-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .n {
    position: relative;
    font-family: var(--hand);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--pen-ink);
    transform: translateY(-0.05em) rotate(-4deg);
  }
  .t {
    font-weight: 640;
    font-size: var(--fs-sm);
    line-height: 1.2;
  }
  .nt {
    font-size: 0.78rem;
    color: var(--ink-2);
    line-height: 1.3;
  }
  .center {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 30%;
    font-weight: 650;
    color: var(--neel-700);
    font-size: var(--fs-md);
    line-height: 1.2;
  }
  .center.hand {
    padding: 28%;
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1.05;
    color: var(--pen-ink);
  }
  .list {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 0.75rem;
  }
  .list li:not(.loop) {
    display: grid;
    grid-template-columns: 1.85rem 1fr;
    column-gap: 0.75rem;
    align-items: start;
  }
  .list .num {
    grid-row: span 2;
  }
  .list .t {
    grid-column: 2;
    padding-top: 0.3rem;
  }
  .list .nt {
    grid-column: 2;
    font-size: var(--fs-xs);
  }
  .list .loop {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-left: 0.2rem;
  }
  .loop-arrow {
    width: 1.5rem;
    height: 1.5rem;
    stroke-width: 2.2;
  }
  .loop .hand {
    font-size: 1.3rem;
  }
  @container (max-width: 34rem) {
    .ring {
      display: none;
    }
    .list {
      display: grid;
    }
  }
  @media print {
    .pencil-line,
    .pencil-ghost {
      stroke: #666;
    }
    .ring-svg .pencil-ghost {
      opacity: 0.4 !important;
    }
  }
</style>
