---
/**
 * Two or three overlapping sets and what they all share: what XLRI, CIPD and SHRM have in
 * common; ability, motivation and opportunity.
 * <Venn sets={[{ label: "XLRI", items: ["Case method"] }, { label: "CIPD" }, { label: "SHRM" }]}
 *   shared={{ label: "All three", items: ["Strategy", "Ethics"] }} />
 *
 * Discs of tracing paper: where they overlap the paper is darker, and what all of them
 * share is written on a tag pinned in the middle. Short lists sit inside their discs.
 * On phones, or when a list is too long to fit inside a disc, the same words become
 * stacked cards. The discs slide together, once, when the diagram scrolls into view.
 */
type Set = { label: string; items?: string[] };
interface Props {
  sets: Set[];
  shared?: { label?: string; items: string[] };
  label?: string;
}
const { sets: all, shared, label } = Astro.props;
const sets = all.slice(0, 3);
const three = sets.length === 3;
const sharedLabel = shared?.label ?? (three ? "Shared by all three" : "Shared by both");
// Will the words fit inside the discs? Short lists of short phrases do; anything longer
// is set as cards at every width rather than squeezed.
const maxItems = three ? 3 : 4;
const chars = (xs: string[] = []) => xs.reduce((n, x) => n + x.length, 0);
const fits =
  sets.length >= 2 &&
  sets.every(
    (s) => s.label.length <= 32 && (s.items?.length ?? 0) <= maxItems && (s.items ?? []).every((i) => i.length <= 48) && chars(s.items) <= (three ? 90 : 120)
  ) &&
  (!shared ||
    (shared.items.every((i) => i.length <= 56) &&
      ((shared.items.length <= 3 && chars(shared.items) <= 110) || (shared.items.length === 4 && chars(shared.items) <= 80))));
const circles = three
  ? [
      { cx: 36, cy: 34, dx: -9, dy: -5 },
      { cx: 64, cy: 34, dx: 9, dy: -5 },
      { cx: 50, cy: 58, dx: 0, dy: 10 }
    ]
  : [
      { cx: 37, cy: 36, dx: -10, dy: 0 },
      { cx: 63, cy: 36, dx: 10, dy: 0 }
    ];
const vb = three ? "0 0 100 92" : "0 0 100 64";
const groupLabel = label ?? `Venn diagram: ${sets.map((s) => s.label).join(", ")}${shared ? `, and ${sharedLabel.toLowerCase()}` : ""}`;
---

<div class:list={["venn", three ? "v3" : "v2", fits ? "can-draw" : "cards-only"]} data-diagram="venn" data-draw role="group" aria-label={groupLabel}>
  <div class="venn-stage">
    <svg class="venn-discs" viewBox={vb} aria-hidden="true" focusable="false">
      {circles.slice(0, sets.length).map((c, i) => <circle class={`d d${i + 1}`} cx={c.cx} cy={c.cy} r="24" style={`--dx:${c.dx}px;--dy:${c.dy}px`} />)}
    </svg>
    {
      sets.map((s, i) => (
        <div class:list={["venn-set", `s${i + 1}`]}>
          <p class="venn-sl">
            <span class="venn-sw" aria-hidden="true" />
            {s.label}
          </p>
          {s.items && s.items.length > 0 && (
            <ul class="venn-items" role="list">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
    {
      shared && (
        <div class="venn-shared">
          <p class="venn-sl">
            <span class="venn-sw venn-sw-all" aria-hidden="true" />
            {sharedLabel}
            <span class="visually-hidden"> (where the circles overlap)</span>
          </p>
          <ul class="venn-items" role="list">
            {shared.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>

<style>
  .venn {
    container-type: inline-size;
  }

  /* ---------- Cards (phones, and lists too long for the discs) ---------- */
  .venn-discs {
    display: none;
  }
  .venn-stage {
    display: grid;
    gap: 0.6rem;
  }
  .venn-set,
  .venn-shared {
    padding: 0.75rem 0.9rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    background: var(--paper);
  }
  .venn-shared {
    border: 1.5px solid var(--haldi-500);
    background: var(--haldi-50);
  }
  .venn-sl {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 680;
    font-size: var(--fs-sm);
    line-height: 1.3;
    color: var(--ink);
  }
  .venn-sw {
    flex-shrink: 0;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    border: 1.5px solid var(--neel-500);
    background: rgb(148 158 226 / 0.35);
  }
  .venn-sw-all {
    width: 1.35rem;
    border-radius: 0;
    border: 0;
    background:
      radial-gradient(circle at 30% 50%, rgb(148 158 226 / 0.5) 0 0.45rem, transparent 0.5rem),
      radial-gradient(circle at 70% 50%, rgb(148 158 226 / 0.5) 0 0.45rem, transparent 0.5rem);
  }
  .venn-items {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0 0 0 1.45rem;
    display: grid;
    gap: 0.2rem;
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .venn-items li {
    position: relative;
  }
  .venn-items li::before {
    content: "";
    position: absolute;
    left: -0.85rem;
    top: 0.62em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--neel-400);
  }
  @container (min-width: 32rem) {
    .cards-only .venn-stage {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
    .cards-only.v2 .venn-stage {
      --cols: 2;
    }
    .cards-only .venn-shared {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Discs (wide figures, when the words fit) ---------- */
  @container (min-width: 32rem) {
    .can-draw .venn-stage {
      position: relative;
      display: block;
      aspect-ratio: 100 / 92;
      max-width: 40rem;
      margin-inline: auto;
    }
    .can-draw.v2 .venn-stage {
      aspect-ratio: 100 / 64;
      max-width: 40rem;
    }
    .can-draw .venn-discs {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .d {
      fill: rgb(148 158 226 / 0.3);
      stroke: var(--neel-500);
      stroke-width: 0.35;
      mix-blend-mode: multiply;
      transform-box: fill-box;
      transform-origin: center;
    }
    .can-draw .venn-set {
      display: contents;
    }
    .can-draw .venn-set .venn-sl,
    .can-draw .venn-set .venn-items,
    .can-draw .venn-shared {
      position: absolute;
      margin: 0;
    }
    .can-draw .venn-set .venn-sl {
      justify-content: center;
      text-align: center;
      width: 32%;
      transform: translateX(-50%);
    }
    .can-draw .venn-set .venn-sw {
      display: none;
    }
    .can-draw .venn-set .venn-items {
      padding: 0;
      text-align: center;
      font-size: var(--fs-xs);
      line-height: 1.35;
      color: var(--ink);
      gap: 0.3rem;
      transform: translateY(-50%);
    }
    .can-draw .venn-set .venn-items li::before {
      display: none;
    }
    /* Three discs: two up, one down. */
    .v3.can-draw .s1 .venn-sl {
      left: 27%;
      top: 4.5%;
    }
    .v3.can-draw .s2 .venn-sl {
      left: 73%;
      top: 4.5%;
    }
    .v3.can-draw .s3 .venn-sl {
      left: 50%;
      top: 90.5%;
    }
    .v3.can-draw .s1 .venn-items {
      left: 15%;
      width: 22%;
      top: 32%;
    }
    .v3.can-draw .s2 .venn-items {
      left: 63%;
      width: 22%;
      top: 32%;
    }
    .v3.can-draw .s3 .venn-items {
      left: 33%;
      width: 34%;
      top: 79%;
    }
    /* Two discs, side by side. */
    .v2.can-draw .s1 .venn-sl {
      left: 30%;
      top: 8%;
    }
    .v2.can-draw .s2 .venn-sl {
      left: 70%;
      top: 8%;
    }
    .v2.can-draw .s1 .venn-items {
      left: 14%;
      width: 23%;
      top: 56%;
    }
    .v2.can-draw .s2 .venn-items {
      left: 63%;
      width: 23%;
      top: 56%;
    }
    /* What they all share: a tag pinned where the discs overlap. */
    .can-draw .venn-shared {
      left: 50%;
      top: 48%;
      transform: translate(-50%, -50%);
      width: max-content;
      max-width: 30%;
      padding: 0.45rem 0.7rem 0.55rem;
      border: 0;
      border-top: 3px solid var(--haldi-500);
      border-radius: 2px;
      background: var(--paper);
      box-shadow:
        0 0 0 1px rgb(17 20 58 / 0.1),
        1.5px 2.5px 0 rgb(17 20 58 / 0.1),
        4px 10px 16px -8px rgb(17 20 58 / 0.35);
      text-align: center;
    }
    .v2.can-draw .venn-shared {
      top: 56%;
      max-width: 26%;
    }
    .can-draw .venn-shared .venn-sl {
      justify-content: center;
      font-size: var(--fs-xs);
    }
    .can-draw .venn-shared .venn-sw {
      display: none;
    }
    .can-draw .venn-shared .venn-items {
      padding: 0;
      margin-top: 0.2rem;
      font-size: var(--fs-xs);
      line-height: 1.35;
      color: var(--ink);
      gap: 0.15rem;
    }
    .can-draw .venn-shared .venn-items li::before {
      display: none;
    }
  }

  /* The discs slide together, once, when scrolled to. */
  :global(html.js-anim) .venn:not(:global(.draw)):not(:global(.drawn)) .d {
    transform: translate(var(--dx), var(--dy));
    opacity: 0.4;
  }
  .venn:global(.draw) .d {
    animation: venn-in 1s var(--ease-draw) both;
  }
  @keyframes venn-in {
    from {
      transform: translate(var(--dx), var(--dy));
      opacity: 0.4;
    }
  }
  @media print {
    .venn {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      break-inside: avoid;
    }
    .venn .d {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .venn-shared {
      box-shadow: none !important;
      border: 1px solid #999;
    }
  }
</style>
