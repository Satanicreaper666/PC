---
/**
 * A continuum with positions on it: unitarist to radical, autocratic to delegative,
 * centralised to devolved HR. `at` runs from 0 (left end) to 100 (right end).
 * <Spectrum left="Unitarist" right="Radical" points={[{ label: "Pluralist", at: 50, note: "…", accent: true }]} />
 *
 * One thread from end to end, a knot for each position. On wide figures each label hangs
 * above or below its knot on a stem; the lanes are worked out here, at build time, so two
 * labels never overlap. On phones, or when the labels are too crowded to sit beside their
 * knots, the knots are numbered and the labels become a numbered list under the thread.
 * The thread draws itself from left to right, once, when scrolled to.
 */
import Icon from "../ui/Icon.astro";
type Point = { label: string; at: number; note?: string; accent?: boolean };
interface Props {
  left: string;
  right: string;
  points: Point[];
  label?: string;
}
const { left, right, points, label } = Astro.props;
const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
const sorted = points.map((p) => ({ ...p, at: clamp(Number(p.at) || 0, 0, 100) })).sort((a, b) => a.at - b.at);

/* ---- Lanes: will every label fit beside its knot on a 34rem (544px) track? ---- */
const TRACK = 544;
const MAXW = 168; // px, the label's max width (10.5rem)
const widthPct = (p: Point) => {
  const chars = Math.max(p.label.length * 1.0, (p.note?.length ?? 0) * 0.8);
  return (Math.min(MAXW, Math.max(60, chars * 7.6 + 10)) / TRACK) * 100;
};
type Placed = Point & { n: number; lane: "above" | "below"; s: number; e: number; anchor: number; align: "start" | "center" | "end" };
const placed: Placed[] = [];
const lastEnd = { above: -100, below: -100 };
let fits = sorted.length > 0;
let prev: "above" | "below" = "below";
sorted.forEach((p, k) => {
  if (!fits) return;
  const w = widthPct(p);
  const c = clamp(p.at, w / 2, 100 - w / 2);
  const s = Math.max(0, Math.floor(c - w / 2));
  const e = Math.min(100, Math.ceil(c + w / 2));
  const order: ("above" | "below")[] = prev === "above" ? ["below", "above"] : ["above", "below"];
  const lane = order.find((l) => s >= lastEnd[l] + 2);
  if (!lane) {
    fits = false;
    return;
  }
  lastEnd[lane] = e;
  prev = lane;
  const align = c > p.at + 0.5 ? "start" : c < p.at - 0.5 ? "end" : "center";
  placed.push({ ...p, n: k + 1, lane, s, e, anchor: Number((((p.at - s) / (e - s)) * 100).toFixed(2)), align });
});
const items = fits ? placed : sorted.map((p, k) => ({ ...p, n: k + 1, lane: "above" as const, s: 0, e: 100, anchor: 50, align: "start" as const }));

/* ---- The numbered rail (phones, or crowded): knots that sit close together step up and down. ---- */
let lastAt = -100;
let step = 0;
const rail = sorted.map((p, k) => {
  step = p.at - lastAt < 5 ? (step + 1) % 3 : 0;
  lastAt = p.at;
  return { n: k + 1, at: p.at, accent: p.accent, dy: [0, -1, 1][step] };
});
const where = (at: number) => `position ${Math.round(at)} on a scale from 0, ${left}, to 100, ${right}`;
---

<div
  class:list={["spec", fits ? "can-lanes" : "list-only"]}
  data-diagram="spectrum"
  data-draw
  role="group"
  aria-label={label ?? `Spectrum from ${left} to ${right}`}
>
  <p class="spec-ends">
    <span class="spec-end spec-left"><Icon name="arrow-left" size={16} /> {left}</span>
    <span class="spec-end spec-right">{right} <Icon name="arrow-right" size={16} /></span>
  </p>

  <div class="spec-rail" aria-hidden="true">
    <span class="spec-thread"></span>
    {
      rail.map((r) => (
        <span class:list={["spec-knot", { accent: r.accent }]} style={`--at:${r.at}%;--dy:${r.dy};--k:${r.n - 1}`}>
          {r.n}
        </span>
      ))
    }
  </div>

  <ol class="spec-points" role="list" style={`--count:${items.length}`}>
    {
      items.map((p) => (
        <li
          class:list={["spec-pt", `lane-${p.lane}`, `al-${p.align}`, { accent: p.accent }]}
          style={`--s:${p.s + 1};--e:${p.e + 1};--anchor:${p.anchor}%;--k:${p.n - 1}`}
        >
          <span class="spec-num" aria-hidden="true">{p.n}</span>
          <span class="spec-body">
            <span class="spec-l">
              {p.label}
              <span class="visually-hidden">
                , {where(p.at)}
                {p.accent ? ", highlighted" : ""}
              </span>
            </span>
            {p.note && <span class="spec-n" set:html={p.note} />}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .spec {
    container-type: inline-size;
    --stem: 1.15rem;
    --knot: 0.95rem;
  }
  .spec-ends {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    font-weight: 680;
    font-size: var(--fs-sm);
    line-height: 1.3;
    color: var(--ink);
  }
  .spec-end {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 48%;
  }
  .spec-right {
    text-align: right;
    justify-content: flex-end;
  }
  .spec-end :global(.icon) {
    color: var(--neel-500);
  }

  /* ---------- Lanes (wide figures, when the labels fit) ---------- */
  .spec-points {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .spec-num {
    display: none;
  }
  .spec-l {
    font-weight: 650;
    font-size: var(--fs-sm);
    line-height: 1.3;
    color: var(--ink);
  }
  .accent .spec-l {
    text-decoration: underline 2px var(--haldi-500);
    text-underline-offset: 4px;
  }
  .spec-n {
    display: block;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--ink-2);
  }
  @container (min-width: 34rem) {
    .can-lanes .spec-rail {
      display: none;
    }
    .can-lanes .spec-points {
      position: relative;
      display: grid;
      grid-template-columns: repeat(100, minmax(0, 1fr));
      grid-template-rows: auto calc(var(--stem) * 2 + 6px) auto;
      margin-top: 0.75rem;
    }
    /* The thread itself, in the middle row. */
    .can-lanes .spec-points::before {
      content: "";
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: center;
      height: 6px;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--neel-200), var(--neel-500));
      transform-origin: left;
    }
    .can-lanes .spec-pt {
      position: relative;
      grid-column: var(--s) / var(--e);
      padding: 0 0.15rem;
      min-width: 0;
    }
    .can-lanes .lane-above {
      grid-row: 1;
      align-self: end;
      padding-bottom: 0.3rem;
    }
    .can-lanes .lane-below {
      grid-row: 3;
      align-self: start;
      padding-top: 0.3rem;
    }
    .can-lanes .al-center {
      text-align: center;
    }
    .can-lanes .al-end {
      text-align: right;
    }
    /* Stem and knot, drawn from each label to its place on the thread. */
    .can-lanes .spec-pt::before,
    .can-lanes .spec-pt::after {
      content: "";
      position: absolute;
      left: var(--anchor);
    }
    .can-lanes .spec-pt::before {
      width: 1.5px;
      height: var(--stem);
      margin-left: -0.75px;
      background: var(--neel-400);
    }
    .can-lanes .lane-above::before {
      top: 100%;
    }
    .can-lanes .lane-below::before {
      bottom: 100%;
    }
    .can-lanes .spec-pt::after {
      width: var(--knot);
      height: var(--knot);
      margin-left: calc(var(--knot) / -2);
      border-radius: 50%;
      background: var(--paper);
      border: 3px solid var(--neel-600);
      box-shadow: 0 0 0 2.5px var(--paper);
    }
    .can-lanes .lane-above::after {
      top: calc(100% + var(--stem) + 3px - var(--knot) / 2);
    }
    .can-lanes .lane-below::after {
      bottom: calc(100% + var(--stem) + 3px - var(--knot) / 2);
    }
    .can-lanes .accent::after {
      --knot: 1.3rem;
      background: var(--accent);
      border-color: var(--haldi-700);
    }
  }

  /* ---------- Numbered rail and list (phones, or crowded) ---------- */
  .spec-rail {
    position: relative;
    height: 3.4rem;
    margin: 0.6rem 0.9rem 0.4rem;
  }
  .spec-thread {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% - 3px);
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--neel-200), var(--neel-500));
    transform-origin: left;
  }
  .spec-knot {
    position: absolute;
    left: var(--at);
    top: calc(50% + var(--dy) * 0.95rem);
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin: -0.8rem 0 0 -0.8rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--neel-600);
    color: var(--neel-800);
    font-size: 0.75rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 2px var(--paper);
  }
  .spec-knot.accent {
    background: var(--accent);
    border-color: var(--haldi-700);
    color: var(--neel-950);
  }
  .spec-points .spec-pt {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
  }
  .spec-points .spec-pt + .spec-pt {
    margin-top: 0.55rem;
  }
  .spec-num {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid var(--neel-600);
    color: var(--neel-800);
    font-size: 0.75rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .accent .spec-num {
    background: var(--accent);
    border-color: var(--haldi-700);
    color: var(--neel-950);
  }
  .spec-body {
    padding-top: 0.1rem;
  }
  @container (min-width: 34rem) {
    .can-lanes .spec-points .spec-pt {
      display: block;
      margin-top: 0;
    }
    .can-lanes .spec-num {
      display: none;
    }
    .list-only .spec-points {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 1.5rem;
    }
    .list-only .spec-points .spec-pt + .spec-pt {
      margin-top: 0;
    }
  }

  /* ---------- Drawn once: the thread runs left to right, then the knots tie on ---------- */
  :global(html.js-anim) .spec:not(:global(.draw)):not(:global(.drawn)) .spec-thread,
  :global(html.js-anim) .spec:not(:global(.draw)):not(:global(.drawn)) .spec-points::before {
    transform: scaleX(0);
  }
  :global(html.js-anim) .spec:not(:global(.draw)):not(:global(.drawn)) .spec-knot,
  :global(html.js-anim) .spec:not(:global(.draw)):not(:global(.drawn)) .spec-pt::after {
    opacity: 0;
  }
  .spec:global(.draw) .spec-thread,
  .spec:global(.draw) .spec-points::before {
    animation: spec-line 1.1s var(--ease-draw) both;
  }
  .spec:global(.draw) .spec-knot,
  .spec:global(.draw) .spec-pt::after {
    animation: spec-knot 0.35s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--k) * 0.12s);
  }
  @keyframes spec-line {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes spec-knot {
    from {
      opacity: 0;
    }
  }
  @media print {
    .spec {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      break-inside: avoid;
    }
    .spec .spec-thread,
    .spec .spec-knot,
    .spec .spec-points::before,
    .spec .spec-pt::after {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
