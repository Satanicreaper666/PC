---
import "./desk.css";
/**
 * Yes/no questions that lead to an answer (up to three levels deep).
 * <DecisionTree node={{ q: "Is gross pay ₹21,000 a month or less?",
 *   yes: { result: "ESI applies", tone: "good" },
 *   no: { result: "ESI does not apply", tone: "neutral" } }} />
 * Rendered as nested lists so screen readers follow the branches in order.
 *
 * On the desk: each question is an index card, the branches are drawn in pen with "Yes" and
 * "No" written beside them, and each answer is a sticky note keyed off its tone: green to go
 * ahead (good), pink to stop or escalate (bad), yellow to act on (accent). A neutral answer
 * stays on plain paper. The answer's own words always say what to do.
 */
type Leaf = { result: string; detail?: string; tone?: "good" | "bad" | "neutral" | "accent" };
type Node = { q: string; detail?: string; yes: Node | Leaf; no: Node | Leaf; yesLabel?: string; noLabel?: string };
interface Props {
  node: Node;
  label?: string;
}
const { node, label } = Astro.props;
const isLeaf = (n: Node | Leaf): n is Leaf => "result" in n;
const paper: Record<string, string> = { good: "dk-sticky dk-green", bad: "dk-sticky dk-pink", accent: "dk-sticky", neutral: "dk-card" };
const tilts = [-0.5, 0.45, -0.3, 0.55];
let notes = 0;
// Handwriting is for short labels only (docs/ART-DIRECTION.md): six words or fewer.
const short = (s: string) => s.trim().split(/\s+/).length <= 6;
// Pen lines: down from the question, out to each answer, and round the corner to the last one.
const LINE = `<svg class="dt-line" viewBox="0 0 4 100" preserveAspectRatio="none" aria-hidden="true"><path d="M2 0c-.6 33 .6 66 0 100"/></svg>`;
const TICK = `<svg class="dt-tick" viewBox="0 0 22 8" preserveAspectRatio="none" aria-hidden="true"><path d="M1 4.3c6.5-.8 13.2-.6 20 .1"/></svg>`;
const CORNER = `<svg class="dt-corner" viewBox="0 0 24 26" preserveAspectRatio="none" aria-hidden="true"><path d="M2 0c.1 8 0 14.6.5 18.4.6 4.1 3.5 6 8.3 6.1 3.4.1 7-.1 11.6-.4"/></svg>`;

function edge(text: string): string {
  return `<span class="dt-edge${short(text) ? " hand" : ""}">${text}</span>`;
}
function render(n: Node | Leaf, depth: number): string {
  if (isLeaf(n)) {
    const tone = n.tone ?? "neutral";
    const tilt = tone === "neutral" ? "" : ` style="--dk-tilt:${tilts[notes++ % tilts.length]}deg"`;
    return `<div class="dt-leaf tone-${tone} ${paper[tone]}"${tilt}><span class="dt-result">${n.result}</span>${n.detail ? `<span class="dt-detail">${n.detail}</span>` : ""}</div>`;
  }
  return `<div class="dt-node dk-card dk-index" style="--d:${depth}"><p class="dt-q">${n.q}</p>${n.detail ? `<p class="dt-detail">${n.detail}</p>` : ""}</div>
  <ul class="dt-branches">
    <li class="dt-branch yes">${LINE}${TICK}${edge(n.yesLabel ?? "Yes")}${render(n.yes, depth + 1)}</li>
    <li class="dt-branch no">${CORNER}${edge(n.noLabel ?? "No")}${render(n.no, depth + 1)}</li>
  </ul>`;
}
const html = render(node, 0);
---

<div class="dt" data-draw role="group" aria-label={label ?? node.q} set:html={html} />

<style>
  .dt {
    --step: 0.9rem;
    --indent: 1.5rem;
    display: grid;
    gap: 0;
    padding: 0.1rem 0.4rem 0.5rem 0;
  }
  /* Questions: index cards. The first one is the card you start from. */
  .dt :global(.dt-node) {
    --dk-rule: 0.6rem;
    justify-self: start;
    max-width: 34rem;
    padding: 1.05rem 1rem 0.75rem;
  }
  .dt :global(.dt-q) {
    font-weight: 640;
    line-height: 1.35;
  }
  .dt > :global(.dt-node:first-child) {
    --dk-rule: 0.7rem;
    padding: 1.25rem 1.15rem 0.9rem;
  }
  .dt > :global(.dt-node:first-child .dt-q) {
    font-size: var(--fs-md);
    letter-spacing: -0.01em;
  }
  .dt :global(.dt-detail) {
    margin-top: 0.2rem;
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.4;
  }
  .dt :global(.dt-branches) {
    list-style: none;
    margin: 0 0 0 1.3rem;
    padding: var(--step) 0 0 var(--indent);
    display: grid;
    gap: var(--step);
  }
  .dt :global(.dt-branch) {
    position: relative;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  /* The pen lines, drawn in the space to the left of each branch. */
  .dt :global(:is(.dt-line, .dt-tick, .dt-corner)) {
    position: absolute;
    fill: none;
    stroke: var(--pen-ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    pointer-events: none;
  }
  .dt :global(.dt-line) {
    left: calc(-1 * var(--indent) - 2px);
    top: calc(-1 * var(--step));
    width: 4px;
    height: calc(100% + var(--step));
  }
  .dt :global(.dt-tick) {
    left: calc(-1 * var(--indent));
    top: 0.47rem;
    width: calc(var(--indent) - 0.125rem);
    height: 0.5rem;
  }
  .dt :global(.dt-corner) {
    left: calc(-1 * var(--indent) - 2px);
    top: calc(-1 * var(--step));
    width: var(--indent);
    height: 1.625rem;
  }
  /* "Yes" and "No", written in pen beside the line. */
  .dt :global(.dt-edge) {
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.4rem;
    color: var(--pen-ink);
  }
  .dt :global(.dt-edge.hand) {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4rem;
    padding-left: 0.1rem;
  }
  /* Answers: a sticky note, or plain paper when the answer is neutral. */
  .dt :global(.dt-leaf) {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.95rem 0.75rem;
    max-width: 30rem;
  }
  .dt :global(.dt-result) {
    font-weight: 650;
    line-height: 1.35;
  }
  .dt :global(.dt-leaf .dt-detail) {
    margin-top: 0;
  }
  :global(html.js-anim) .dt:not(.draw):not(.drawn) :global(.dt-branches) {
    clip-path: inset(-1rem -3rem 100% -3rem);
  }
  .dt:global(.draw) :global(.dt-branches) {
    animation: dt-open 1s var(--ease-draw) both;
  }
  /* Open well past the edges at the end, so no paper shadow is clipped. */
  @keyframes dt-open {
    from {
      clip-path: inset(-1rem -3rem 100% -3rem);
    }
    to {
      clip-path: inset(-1rem -3rem -3rem -3rem);
    }
  }
  @media (max-width: 560px) {
    .dt {
      --indent: 1.25rem;
    }
    .dt :global(.dt-branches) {
      margin-left: 0.9rem;
    }
  }
  /* Printed: every branch is on the page, whether or not it was scrolled to. */
  @media print {
    .dt :global(:is(.dt-line, .dt-tick, .dt-corner)) {
      stroke: #333;
    }
    .dt :global(.dt-branches) {
      clip-path: none !important;
      animation: none !important;
    }
  }
</style>
