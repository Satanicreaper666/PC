---
import Icon from "../ui/Icon.astro";
import { resolveRefs } from "../../lib/library";

// Common starting points. Refs that don't exist yet are skipped automatically.
const quick = await resolveRefs([
  "toolkit/take-home-salary-calculator",
  "toolkit/gratuity-calculator",
  "toolkit/notice-period-calculator",
  "toolkit/full-and-final-settlement-calculator",
  "toolkit/resignation-letter",
  "handbooks/labour-law/03-leave-and-working-hours"
]);
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="panel" data-search-root>
    <h2 id="search-title" class="visually-hidden">Search the library</h2>
    <div class="input-row">
      <Icon name="search" size={20} class="lead" />
      <input
        class="input"
        type="search"
        placeholder="Search guides, templates, calculators and terms"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search the library"
        aria-controls="search-results"
        aria-describedby="search-status"
        data-search-input
      />
      <button class="close" type="button" data-search-close>
        <span class="visually-hidden">Close search</span>
        <kbd class="kbd" aria-hidden="true">Esc</kbd>
      </button>
    </div>
    <p id="search-status" class="status" role="status" aria-live="polite" data-search-status></p>
    <div class="body">
      <ul id="search-results" class="results" data-search-results></ul>
      <div class="quick" data-search-quick hidden={quick.length === 0}>
        <p class="quick-label">Common starting points</p>
        <ul>
          {
            quick.map((q) => (
              <li>
                <a href={q.href} class="result">
                  <span class="kind">{q.kind}</span>
                  <span class="title">{q.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="foot tiny muted">Search runs on this page. What you type is not sent anywhere.</p>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(42rem, calc(100% - 1.5rem));
    max-height: min(40rem, calc(100dvh - 3rem));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: var(--shadow-float);
    color: var(--ink);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgb(17 20 58 / 0.45);
    backdrop-filter: blur(2px);
  }
  .search-dialog[open] {
    animation: pop 180ms var(--ease-out);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .input-row :global(.lead) {
    color: var(--ink-3);
  }
  .input {
    flex: 1;
    min-height: 2.5rem;
    border: 0;
    outline: none;
    background: transparent;
    font-size: var(--fs-md);
  }
  .input::-webkit-search-cancel-button {
    display: none;
  }
  .close {
    border: 0;
    background: none;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 6px;
  }
  .kbd {
    display: inline-flex;
    padding: 0 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-3);
    font-family: inherit;
  }
  .status {
    padding: 0 1rem;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .status:not(:empty) {
    padding-top: 0.6rem;
  }
  .body {
    overflow-y: auto;
    padding: 0.5rem;
  }
  .results,
  .quick ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quick-label {
    padding: 0.5rem 0.6rem 0.25rem;
    font-size: var(--fs-xs);
    color: var(--ink-3);
    font-weight: 560;
  }
  .result,
  .results :global(a) {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--r);
    text-decoration: none;
    color: inherit;
  }
  .result:hover,
  .result:focus-visible,
  .results :global(a:hover),
  .results :global(a:focus-visible),
  .results :global(a[aria-selected="true"]) {
    background: var(--canvas);
    outline: none;
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .kind,
  .results :global(.kind) {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    font-weight: 560;
  }
  .title,
  .results :global(.title) {
    font-weight: 620;
  }
  .results :global(.excerpt) {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.45;
  }
  .results :global(mark) {
    background: linear-gradient(100deg, color-mix(in srgb, var(--hl-yellow) 55%, transparent), var(--hl-yellow) 0.25em, var(--hl-yellow) calc(100% - 0.25em), color-mix(in srgb, var(--hl-yellow) 50%, transparent)) 0 90% / 100% 0.8em no-repeat;
    color: inherit;
    border-radius: 0.25em 0.1em;
    padding: 0 0.12em;
  }
  .foot {
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--line);
  }
</style>
