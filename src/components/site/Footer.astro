---
import Logo from "../ui/Logo.astro";
import { SITE } from "../../data/site";
import { AUDIENCES, AUDIENCE_INFO } from "../../data/taxonomy";
---

<footer class="site-footer band-ink">
  <div class="wrap grid">
    <div class="about">
      <Logo size={30} tone="inverse" />
      <p class="mission">
        A free HR library for India: handbooks in plain English, with calculators, letters and checklists to act on them. No sign-up, no tracking.
      </p>
      <p class="note">Information, not legal advice. For decisions about your own case, check with your HR team, a lawyer or the labour department.</p>
    </div>
    <nav aria-label="Library">
      <h2>Library</h2>
      <ul>
        <li><a href="/handbooks/">Handbooks</a></li>
        <li><a href="/learn/">Learn: the free HR course</a></li>
        <li><a href="/toolkit/">Toolkit</a></li>
        <li><a href="/jd-library/">JD library</a></li>
        <li><a href="/toolkit/people-analytics/">People analytics</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/search/">Search</a></li>
      </ul>
    </nav>
    <nav aria-label="Start here">
      <h2>Start here</h2>
      <ul>
        {
          AUDIENCES.map((a) => (
            <li>
              <a href={AUDIENCE_INFO[a].path}>{AUDIENCE_INFO[a].label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="About PeopleCraft">
      <h2>About</h2>
      <ul>
        <li><a href="/about/">About PeopleCraft</a></li>
        <li><a href="/about/how-we-check/">How we check facts</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms of use</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {SITE.year} PeopleCraft. Templates are free to copy and adapt.</p>
    <p>Built in Bengaluru by <a href="/about/">Akash Mukundan</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    --logo-bg: var(--neel-950);
    padding-block: var(--s-8) var(--s-6);
    margin-top: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--s-6);
  }
  .mission {
    margin-top: var(--s-4);
    max-width: 34ch;
    color: #e9ebf7;
  }
  .note {
    margin-top: var(--s-3);
    max-width: 40ch;
    font-size: var(--fs-xs);
    color: var(--neel-300);
  }
  h2 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--neel-300) !important;
    letter-spacing: 0;
  }
  ul {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  a {
    color: #e9ebf7;
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal a {
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    font-size: var(--fs-xs);
    color: var(--neel-300);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
