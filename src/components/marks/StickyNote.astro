---
/**
 * A sticky note taped to the page. Yellow: a tip to act on. Pink: a warning or risk.
 * Green: good practice. Blue: good to know. The title is handwritten; the body never is.
 */
interface Props {
  color?: "yellow" | "pink" | "green" | "blue";
  title?: string;
  tilt?: number;
  label?: string;
  class?: string;
}
const { color = "yellow", title, tilt = -0.4, label, class: cls } = Astro.props;
---

<div role="note" class:list={["sticky", `sticky-${color}`, cls]} style={`--tilt:${tilt}deg`} aria-label={label ?? title} data-no-terms>
  <span class="tape" aria-hidden="true"></span>
  {title && <p class="sticky-title hand">{title}</p>}
  <div class="sticky-body"><slot /></div>
</div>

<style>
  .sticky {
    --note: #fff3a6;
    --note-edge: #f2df6f;
    position: relative;
    padding: 1.35rem 1.35rem 1.2rem;
    border-radius: 2px 2px 3px 14px / 2px 2px 3px 6px;
    background:
      linear-gradient(170deg, rgb(255 255 255 / 0.35), transparent 40%),
      var(--note);
    color: var(--ink);
    transform: rotate(var(--tilt));
    /* Lifted at the bottom right corner, the way a sticky note curls. */
    box-shadow:
      0 1px 1px rgb(17 20 58 / 0.08),
      3px 8px 14px -6px rgb(17 20 58 / 0.28),
      inset 0 -2px 0 var(--note-edge);
  }
  .sticky-pink {
    --note: #ffd9e8;
    --note-edge: #f7b7d1;
  }
  .sticky-green {
    --note: #d6f5dc;
    --note-edge: #ade6ba;
  }
  .sticky-blue {
    --note: #dcecff;
    --note-edge: #b8d6fb;
  }
  .tape {
    position: absolute;
    top: -0.65rem;
    left: 50%;
    width: 5.5rem;
    height: 1.4rem;
    margin-left: -2.75rem;
    transform: rotate(calc(var(--tilt) * -3 - 2deg));
    background: linear-gradient(180deg, rgb(255 255 255 / 0.78), rgb(246 247 252 / 0.7));
    box-shadow:
      0 0 0 0.5px rgb(17 20 58 / 0.1),
      0 1px 2px rgb(17 20 58 / 0.16);
    -webkit-mask: conic-gradient(from -45deg at left, #0000, #000 1deg 89deg, #0000 90deg) left / 4px 6px repeat-y,
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 135deg at right, #0000, #000 1deg 89deg, #0000 90deg) right / 4px 6px repeat-y;
    mask: conic-gradient(from -45deg at left, #0000, #000 1deg 89deg, #0000 90deg) left / 4px 6px repeat-y,
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 135deg at right, #0000, #000 1deg 89deg, #0000 90deg) right / 4px 6px repeat-y;
  }
  .sticky-title {
    font-size: 1.55rem;
    margin-bottom: 0.35rem;
    color: var(--pen-ink);
  }
  .sticky-pink .sticky-title {
    color: var(--pen-red);
  }
  .sticky-body {
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .sticky-body :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .sticky-body :global(li::marker) {
    color: var(--pen-ink);
  }
  .sticky-body :global(a) {
    color: var(--ink);
    text-decoration-color: var(--pen-ink);
  }
  @media print {
    .sticky {
      transform: none;
      box-shadow: none;
      border: 1px solid #ccc;
    }
    .tape {
      display: none;
    }
  }
</style>
