---
/**
 * The library's card. Its edge says what kind of paper it is, so a reader can
 * tell a letter from a calculator before reading a word:
 *   sheet     letters, forms, policies     a page with its corner folded down
 *   slip      calculators, apps            a printed slip, torn along the bottom
 *   pad       checklists, surveys, plans   a page from a pad, punched at the top
 *   book      handbook chapters            bound in the book's own woven cloth
 *   badge     job descriptions             an ID card with a lanyard slot
 *   catalogue glossary terms               a ruled catalogue card with a rod hole
 * The paper-cut spot icon is pinned half over the top edge.
 *
 * <ItemCard href="/toolkit/offer-letter/" art="letter" kind="Letter" code="PC-F-07"
 *   title="Offer letter" description="…" meta="32 details to fill, then Word or PDF" />
 */
import SpotIcon from "../art/SpotIcon.astro";
import Weave from "./Weave.astro";
import { BOOKS, type BookId } from "../../data/books";
interface Props {
  href: string;
  art: string;
  kind: string;
  title: string;
  description?: string;
  meta?: string;
  code?: string;
}
const { href, art, kind, title, description, meta, code } = Astro.props;
const SHAPE: Record<string, string> = {
  letter: "sheet",
  form: "sheet",
  policy: "sheet",
  calculator: "slip",
  app: "slip",
  checklist: "pad",
  survey: "pad",
  plan: "pad",
  jd: "badge",
  glossary: "catalogue"
};
const book = art in BOOKS ? (art as BookId) : undefined;
const shape = book ? "book" : (SHAPE[art] ?? "sheet");
const cloth = book ? BOOKS[book].cloth : undefined;
---

<a class:list={["lib-card", `shape-${shape}`]} href={href}>
  <span class="paper" aria-hidden="true"><span class="sheet"></span></span>
  {
    cloth && (
      <span class="spine" aria-hidden="true">
        <Weave structure={cloth.structure} cols={1} rows={14} cell={14} warp={cloth.warp} weft={cloth.weft} gap={cloth.gap} accent={cloth.accent} bleed={4} />
      </span>
    )
  }
  {shape === "sheet" && <span class="fold" aria-hidden="true" />}
  <span class="tile" aria-hidden="true"><SpotIcon name={art} size={40} /></span>
  <span class="top">
    <span class="k">{kind}</span>
    {code && <span class="code">{code}</span>}
  </span>
  <span class="t">{title}</span>
  {description && <span class="d">{description}</span>}
  {meta && <span class="m">{meta}</span>}
</a>

<style>
  .lib-card {
    --cut: none;
    position: relative;
    isolation: isolate;
    height: calc(100% - 1.25rem);
    margin-top: 1.25rem;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 0.3rem;
    padding: 0.7rem 1.15rem 1rem;
    color: inherit;
    text-decoration: none;
    transition: transform 220ms var(--ease-out);
  }
  /* The paper: cut to the card's shape, then lit. The filter sits on the parent so the
     shadow follows every cut (folded corner, punched holes, torn edge). */
  .paper {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: drop-shadow(0 0 0.8px rgb(17 20 58 / 0.55)) drop-shadow(1.5px 2px 0 rgb(17 20 58 / 0.08));
    transition: filter 220ms var(--ease);
  }
  .sheet {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px rgb(17 20 58 / 0.1);
    -webkit-mask: var(--cut);
    mask: var(--cut);
  }
  .lib-card:hover {
    transform: translateY(-2px);
  }
  .lib-card:hover .paper {
    filter: drop-shadow(0 0 0.6px rgb(59 68 166 / 0.6)) drop-shadow(3px 6px 8px rgb(17 20 58 / 0.18));
  }
  .lib-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  /* sheet: the top right corner folded down */
  .shape-sheet {
    --cut: linear-gradient(225deg, transparent 0 0.78rem, #000 0.78rem);
  }
  .fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 1.1rem;
    height: 1.1rem;
    background: linear-gradient(225deg, transparent 50%, var(--neel-100) 50%);
    border-bottom-left-radius: 3px;
    filter: drop-shadow(-1px 1.5px 1px rgb(17 20 58 / 0.18));
  }
  /* slip: torn along the bottom like a printed receipt */
  .shape-slip {
    padding-bottom: 1.35rem;
    --cut:
      linear-gradient(#000 0 0) top / 100% calc(100% - 7px) no-repeat,
      conic-gradient(from -45deg at 50% 100%, transparent, #000 1deg 89deg, transparent 90deg) bottom / 14px 7px repeat-x;
  }
  .shape-slip .sheet {
    border-radius: 4px 4px 0 0;
  }
  /* pad: three punched holes along the top */
  .shape-pad .sheet {
    -webkit-mask:
      radial-gradient(circle 4px at 46% 0.55rem, transparent 98%, #000),
      radial-gradient(circle 4px at 62% 0.55rem, transparent 98%, #000),
      radial-gradient(circle 4px at 78% 0.55rem, transparent 98%, #000);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle 4px at 46% 0.55rem, transparent 98%, #000),
      radial-gradient(circle 4px at 62% 0.55rem, transparent 98%, #000),
      radial-gradient(circle 4px at 78% 0.55rem, transparent 98%, #000);
    mask-composite: intersect;
  }
  .shape-pad .top {
    padding-top: 0.55rem;
  }
  /* badge: an ID card with a lanyard slot */
  .shape-badge .sheet {
    -webkit-mask: radial-gradient(10px 3px at 50% 0.6rem, transparent 98%, #000);
    mask: radial-gradient(10px 3px at 50% 0.6rem, transparent 98%, #000);
    border-radius: 12px;
  }
  /* catalogue: ruled card stock with a hole for the drawer rod */
  .shape-catalogue .sheet {
    background-image: repeating-linear-gradient(180deg, transparent 0 1.45rem, rgb(76 86 190 / 0.12) 1.45rem calc(1.45rem + 1px));
    background-position: 0 2.2rem;
    -webkit-mask: radial-gradient(circle 5px at 50% calc(100% - 0.7rem), transparent 98%, #000);
    mask: radial-gradient(circle 5px at 50% calc(100% - 0.7rem), transparent 98%, #000);
    border-radius: 3px;
  }
  .shape-catalogue {
    padding-bottom: 1.6rem;
  }
  /* book: bound in the book's woven cloth */
  .shape-book {
    padding-left: 1.75rem;
  }
  .shape-book .sheet {
    border-radius: 3px 8px 8px 3px;
  }
  .spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.8rem;
    overflow: hidden;
    border-radius: 3px 0 0 3px;
    box-shadow: inset -2px 0 3px rgb(0 0 0 / 0.25);
  }
  .spine :global(.weave) {
    height: 100%;
    width: 100%;
  }

  /* The spot icon's own piece of paper, pinned over the top edge. */
  .tile {
    position: absolute;
    top: -1.25rem;
    left: 0.95rem;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(17 20 58 / 0.07),
      1.5px 2.5px 0 rgb(17 20 58 / 0.1),
      3px 6px 8px -2px rgb(17 20 58 / 0.14);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease);
  }
  .shape-book .tile {
    left: 1.55rem;
  }
  .lib-card:hover .tile {
    transform: translateY(-2px) rotate(-3deg);
    box-shadow:
      0 0 0 1px rgb(17 20 58 / 0.07),
      2px 4px 0 rgb(17 20 58 / 0.09),
      5px 10px 14px -4px rgb(17 20 58 / 0.2);
  }
  .top {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 1.5rem;
    padding-left: 3.6rem;
    padding-right: 0.6rem;
  }
  .k {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  .code {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--neel-700);
    font-variant-numeric: tabular-nums;
  }
  .t {
    margin-top: 0.35rem;
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  .lib-card:hover .t {
    color: var(--primary);
  }
  .d {
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .m {
    align-self: end;
    margin-top: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--line-strong);
    font-size: var(--fs-xs);
    font-weight: 560;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) {
    .lib-card,
    .paper,
    .tile {
      transition: none;
    }
    .lib-card:hover,
    .lib-card:hover .tile {
      transform: none;
    }
  }
</style>
