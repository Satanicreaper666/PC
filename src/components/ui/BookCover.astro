---
/**
 * A handbook as a bound piece of cloth: woven in the book's own structure,
 * with its paper-cut emblem pinned on and a sewn-on label carrying the title.
 * Sizes: "lg" (book page header), "md" (handbooks shelf), "sm" (a swatch beside a chapter).
 */
import Weave from "./Weave.astro";
import SpotIcon from "../art/SpotIcon.astro";
import { BOOKS, type BookId } from "../../data/books";
interface Props {
  id: BookId;
  size?: "lg" | "md" | "sm";
  /** Shown under the title on the label, e.g. "11 chapters". */
  note?: string;
  class?: string;
}
const { id, size = "md", note, class: cls } = Astro.props;
const b = BOOKS[id];
const c = b.cloth;
const grid = size === "sm" ? { cols: 5, rows: 6 } : { cols: 9, rows: 12 };
---

<div class:list={["cover", `cover-${size}`, cls]} style={`--gap:${c.gap}`} aria-hidden={size === "sm" ? "true" : undefined}>
  <Weave
    class="cloth"
    structure={c.structure}
    cols={grid.cols}
    rows={grid.rows}
    cell={20}
    warp={c.warp}
    weft={c.weft}
    gap={c.gap}
    accent={c.accent}
    accentCols={c.accentCols}
    accentRows={c.accentRows}
  />
  <span class="spine" aria-hidden="true"></span>
  {
    size !== "sm" && (
      <>
        <span class="emblem" aria-hidden="true">
          <SpotIcon name={id} size={size === "lg" ? 64 : 48} />
        </span>
        <span class="label">
          <span class="lt">{b.title}</span>
          {note && <span class="ln">{note}</span>}
        </span>
      </>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 6px 14px 14px 6px;
    overflow: hidden;
    background: var(--gap);
    isolation: isolate;
    /* A bound book on a table: crisp edge, long soft shadow down and right. */
    box-shadow:
      2px 3px 0 rgb(17 20 58 / 0.18),
      10px 18px 30px -12px rgb(17 20 58 / 0.45);
  }
  .cloth {
    position: absolute;
    inset: 0;
  }
  /* The binding: a darker band with stitches. */
  .spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 9%;
    background:
      repeating-linear-gradient(180deg, transparent 0 10px, rgb(255 255 255 / 0.35) 10px 15px) center / 2px 100% no-repeat,
      linear-gradient(90deg, rgb(0 0 0 / 0.38), rgb(0 0 0 / 0.12));
    box-shadow: inset -1px 0 0 rgb(255 255 255 / 0.12);
  }
  .emblem {
    position: absolute;
    top: 9%;
    right: 9%;
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    box-shadow:
      1.5px 2.5px 0 rgb(17 20 58 / 0.22),
      4px 8px 12px -4px rgb(0 0 0 / 0.4);
  }
  .emblem :global(.spot) {
    width: 82%;
    height: 82%;
  }
  /* A sewn-on label: white cloth with a running stitch inside its edge. */
  .label {
    position: absolute;
    left: 15%;
    right: 8%;
    bottom: 8%;
    display: grid;
    gap: 0.25rem;
    padding: 0.7rem 0.8rem 0.75rem;
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      inset 0 0 0 4px var(--paper),
      inset 0 0 0 5px rgb(17 20 58 / 0.0),
      1.5px 2.5px 0 rgb(0 0 0 / 0.25),
      4px 8px 14px -6px rgb(0 0 0 / 0.45);
    outline: 1.5px dashed var(--neel-300);
    outline-offset: -6px;
  }
  .lt {
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .ln {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  .cover-lg .lt {
    font-size: var(--fs-lg);
  }
  .cover-md .lt {
    font-size: var(--fs-base);
  }
  .cover-md .label {
    padding: 0.6rem 0.7rem 0.65rem;
  }
  .cover-sm {
    border-radius: 3px 7px 7px 3px;
    box-shadow:
      1px 1.5px 0 rgb(17 20 58 / 0.2),
      3px 6px 10px -4px rgb(17 20 58 / 0.4);
  }
</style>
