---
/**
 * The PeopleCraft mark: a 3 × 3 plain weave. Warp and weft cross over and
 * under; the centre thread is turmeric — one person in the fabric of work.
 */
interface Props {
  variant?: "full" | "mark";
  size?: number;
  tone?: "default" | "inverse";
  class?: string;
  label?: string;
}
const { variant = "full", size = 30, tone = "default", class: className, label = "PeopleCraft" } = Astro.props;

const pos = [4.5, 13.5, 22.5];
const w = 5;
const ext = 1.4;
const colors =
  tone === "inverse"
    ? { warp: "#BCC3EE", weft: "#4C56BE", accent: "#EFAB22", gap: "var(--logo-bg, #11143A)" }
    : { warp: "#2F3786", weft: "#949EE2", accent: "#EFAB22", gap: "var(--logo-bg, #FFFFFF)" };

const weft = pos.map((y) => `<rect x="1" y="${y}" width="30" height="${w}" rx="2.5" fill="${colors.weft}"/>`).join("");
const warp = pos
  .map((x, j) => `<rect x="${x}" y="1" width="${w}" height="30" rx="2.5" fill="${j === 1 ? colors.accent : colors.warp}"/>`)
  .join("");
const over = pos
  .flatMap((y, i) => pos.map((x, j) => ((i + j) % 2 === 1 ? `<rect x="${x - ext}" y="${y}" width="${w + 2 * ext}" height="${w}" fill="${colors.weft}"/>` : "")))
  .join("");
const svg = `<g stroke="${colors.gap}" stroke-width="1.3" paint-order="stroke">${weft}${warp}${over}</g>`;
---

<span class:list={["logo", `logo-${tone}`, className]} role="img" aria-label={label}>
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" set:html={svg} />
  {variant === "full" && <span class="logo-word" aria-hidden="true">PeopleCraft</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1;
  }
  .logo-mark {
    display: block;
  }
  .logo-word {
    font-weight: 660;
    font-stretch: 106%;
    font-size: 1.28rem;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .logo-inverse .logo-word {
    color: #fff;
  }
</style>
