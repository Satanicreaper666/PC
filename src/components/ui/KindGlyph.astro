---
/**
 * Small drawings of what an item is: a letter looks like a letter, a checklist
 * like a checklist. Drawn in the loom's language (neel threads, one turmeric
 * accent). Decorative: the card around it always names the kind in text.
 * The accent part moves when the card is hovered; see .lib-card in global.css.
 */
export type Glyph = "letter" | "form" | "policy" | "checklist" | "survey" | "plan" | "calculator" | "app" | "chapter" | "jd" | "term";
interface Props {
  kind: Glyph | string;
  class?: string;
}
const { kind, class: cls } = Astro.props;
const sheet = "M10 5a2 2 0 0 1 2-2h18l8 8v24a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2Z";
const fold = "M30 3v6a2 2 0 0 0 2 2h6";
---

<svg class:list={["glyph", `glyph-${kind}`, cls]} viewBox="0 0 48 40" aria-hidden="true" focusable="false">
  {
    kind === "letter" && (
      <>
        <path class="g-paper" d={sheet} />
        <path class="g-line" d={fold} />
        <path class="g-soft" d="M15 15h10" />
        <rect class="g-acc" x="15" y="19" width="13" height="4.5" rx="1.2" />
        <path class="g-soft" d="M15 28h17M15 32h12" />
      </>
    )
  }
  {
    kind === "form" && (
      <>
        <path class="g-paper" d={sheet} />
        <path class="g-line" d={fold} />
        <rect class="g-box" x="15" y="12" width="17" height="5.5" rx="1" />
        <rect class="g-box" x="15" y="21" width="17" height="5.5" rx="1" />
        <rect class="g-box" x="15" y="30" width="4" height="4" rx="0.8" />
        <path class="g-acc-line" d="M15.8 32.1l1.2 1.2 2.6-2.8" />
        <path class="g-soft" d="M22 32h9" />
      </>
    )
  }
  {
    kind === "policy" && (
      <>
        <path class="g-paper" d={sheet} />
        <path class="g-line" d={fold} />
        <circle class="g-acc" cx="16" cy="15" r="2" />
        <path class="g-soft" d="M20.5 15h11" />
        <circle class="g-knot" cx="16" cy="22" r="2" />
        <path class="g-soft" d="M20.5 22h9" />
        <circle class="g-knot" cx="16" cy="29" r="2" />
        <path class="g-soft" d="M20.5 29h11" />
      </>
    )
  }
  {
    kind === "checklist" && (
      <>
        <rect class="g-acc" x="7" y="6" width="7" height="7" rx="1.6" />
        <path class="g-tick" d="M8.8 9.6l1.6 1.6 2.4-2.7" />
        <path class="g-line" d="M18 9.5h22" />
        <rect class="g-box" x="7" y="16.5" width="7" height="7" rx="1.6" />
        <path class="g-line-thin" d="M8.8 20.1l1.6 1.6 2.4-2.7" />
        <path class="g-soft" d="M18 20h18" />
        <rect class="g-box" x="7" y="27" width="7" height="7" rx="1.6" />
        <path class="g-soft" d="M18 30.5h20" />
      </>
    )
  }
  {
    kind === "survey" && (
      <>
        <path class="g-thread" d="M4 24h40" />
        <circle class="g-knot" cx="8" cy="24" r="3" />
        <circle class="g-knot" cx="16" cy="24" r="3" />
        <circle class="g-knot" cx="24" cy="24" r="3" />
        <circle class="g-acc" cx="32" cy="24" r="4.2" />
        <circle class="g-knot" cx="40" cy="24" r="3" />
        <path class="g-soft" d="M8 12h22" />
      </>
    )
  }
  {
    kind === "plan" && (
      <>
        <path class="g-thread" d="M5 26h38" />
        <circle class="g-acc" cx="9" cy="26" r="4" />
        <circle class="g-knot" cx="24" cy="26" r="3.2" />
        <circle class="g-knot" cx="39" cy="26" r="3.2" />
        <path class="g-soft" d="M5 14h9M20 14h8M35 14h8" />
      </>
    )
  }
  {
    kind === "calculator" && (
      <>
        <rect class="g-box" x="5" y="7" width="7" height="7" rx="1.6" />
        <rect class="g-box" x="14" y="7" width="7" height="7" rx="1.6" />
        <rect class="g-box" x="5" y="16" width="7" height="7" rx="1.6" />
        <rect class="g-box" x="14" y="16" width="7" height="7" rx="1.6" />
        <rect class="g-box" x="5" y="25" width="16" height="7" rx="1.6" />
        <rect class="g-bar" x="26" y="9" width="17" height="5" rx="2.5" />
        <rect class="g-acc" x="26" y="18" width="11" height="5" rx="2.5" />
        <rect class="g-bar-soft" x="26" y="27" width="14" height="5" rx="2.5" />
      </>
    )
  }
  {
    kind === "app" && (
      <>
        <rect class="g-paper" x="4" y="9" width="18" height="22" rx="2" />
        <path class="g-soft" d="M4 16.5h18M4 23.5h18M10 9v22M16 9v22" />
        <path class="g-line" d="M25 20h5m-2-2.5 2.5 2.5-2.5 2.5" />
        <rect class="g-bar" x="33" y="17" width="3.6" height="14" rx="1.2" />
        <rect class="g-acc" x="38.2" y="11" width="3.6" height="20" rx="1.2" />
        <rect class="g-bar-soft" x="43.4" y="22" width="3.6" height="9" rx="1.2" />
      </>
    )
  }
  {
    kind === "chapter" && (
      <>
        <path class="g-paper" d="M24 9c-4-3-10-4-17-3v26c7-1 13 0 17 3 4-3 10-4 17-3V6c-7-1-13 0-17 3Z" />
        <path class="g-line" d="M24 9v26" />
        <path class="g-soft" d="M11 13h9M11 18h9M28 13h9M28 18h9M28 23h7" />
        <path class="g-acc" d="M13 22h5v9l-2.5-2-2.5 2Z" />
      </>
    )
  }
  {
    kind === "jd" && (
      <>
        <rect class="g-paper" x="6" y="6" width="36" height="28" rx="3" />
        <circle class="g-knot" cx="16" cy="17" r="4.2" />
        <path class="g-line" d="M9.5 28c1.2-3.6 3.6-5.2 6.5-5.2s5.3 1.6 6.5 5.2" />
        <path class="g-soft" d="M27 14h10M27 19h8" />
        <rect class="g-acc" x="27" y="24" width="10" height="4" rx="1.2" />
      </>
    )
  }
  {
    kind === "term" && (
      <>
        <rect class="g-paper" x="6" y="6" width="36" height="28" rx="3" />
        <path class="g-line" d="M12 15h13" />
        <rect class="g-acc" x="12" y="17.5" width="13" height="2.2" rx="1.1" />
        <path class="g-soft" d="M12 25h24M12 29h18" />
      </>
    )
  }
</svg>

<style>
  .glyph {
    width: 48px;
    height: 40px;
    flex-shrink: 0;
    overflow: visible;
  }
  .glyph :global(.g-paper) {
    fill: var(--paper);
    stroke: var(--neel-600);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .glyph :global(.g-line) {
    fill: none;
    stroke: var(--neel-600);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph :global(.g-line-thin) {
    fill: none;
    stroke: var(--neel-400);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph :global(.g-soft) {
    fill: none;
    stroke: var(--neel-200);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .glyph :global(.g-thread) {
    fill: none;
    stroke: var(--neel-200);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .glyph :global(.g-box) {
    fill: var(--neel-50);
    stroke: var(--neel-400);
    stroke-width: 1.4;
  }
  .glyph :global(.g-knot) {
    fill: var(--paper);
    stroke: var(--neel-600);
    stroke-width: 1.8;
  }
  .glyph :global(.g-bar) {
    fill: var(--neel-500);
  }
  .glyph :global(.g-bar-soft) {
    fill: var(--neel-200);
  }
  .glyph :global(.g-acc) {
    fill: var(--haldi-400);
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform 260ms var(--ease-out);
  }
  .glyph :global(.g-acc-line) {
    fill: none;
    stroke: var(--haldi-600);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph :global(.g-tick) {
    fill: none;
    stroke: var(--neel-950);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
