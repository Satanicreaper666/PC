---
import CalcShell from "../calc/CalcShell.astro";
import Num from "../calc/Num.astro";
import Pick from "../calc/Pick.astro";
import DateIn from "../calc/DateIn.astro";
import AsAt from "./parts/AsAt.astro";
import { SEPARATION_LABELS } from "../../lib/calc/full-and-final";
import { WEEKLY_OFF_LABELS } from "../../lib/calc/working-days";
import { PT_PICKER } from "../../lib/calc/professional-tax";
import { stat } from "../../data/statutory";

const supervisorLimit = stat("osh.supervisorWageLimit").display;
const pfCeiling = stat("epf.wageCeiling").display.replace(/ a month$/, "");
const capMonths = stat("notice.closureCompensationCapMonths").display;
---

<CalcShell id="full-and-final" resultLabel="Full and final settlement" inputsLabel="Exit details" bars paper="statement">
  <Fragment slot="inputs">
    <Pick name="exit" label="How is employment ending?" style="select" options={Object.entries(SEPARATION_LABELS).map(([value, label]) => ({ value, label }))} />
    <Pick
      name="type"
      label="Type of employment"
      options={[
        { value: "permanent", label: "Permanent" },
        { value: "fixed_term", label: "Fixed-term" }
      ]}
    />
    <div class="two">
      <DateIn name="doj" label="Date of joining" value="2019-04-01" />
      <DateIn name="lwd" label="Last working day" value="2026-12-04" />
    </div>

    <p class="group">Final month's salary</p>
    <Num name="gross" label="Monthly gross salary" prefix="₹" value="93,000" help="Fixed monthly pay before deductions." />
    <Pick
      name="basis"
      label="Part-month salary is worked on"
      options={[
        { value: "calendar", label: "Days in the month" },
        { value: "30", label: "30 days" },
        { value: "26", label: "26 days" }
      ]}
      help="Use your payroll's usual basis."
    />
    <Num name="paid" label="Payable days in the last month (optional)" suffix="days" placeholder="From the dates" help="Leave blank to count from the 1st (or the joining date) to the last working day. Take off any unpaid leave." />

    <p class="group">Leave and gratuity</p>
    <Num
      name="wages"
      label="Monthly wages for gratuity and leave"
      prefix="₹"
      value="60,000"
      help="Basic pay, dearness allowance and other pay the Labour Codes count as wages. Leave out HRA, conveyance, overtime and commission, unless together they exceed half of total pay; then add the excess."
    />
    <div class="two">
      <Num name="leave" label="Unused leave to encash" suffix="days" value="18" />
      <Pick
        name="ldiv"
        label="A day's wages is"
        options={[
          { value: "26", label: "÷ 26" },
          { value: "30", label: "÷ 30" }
        ]}
        help="Also used for retrenchment compensation."
      />
    </div>
    <Pick
      name="worker"
      label="Is the employee a 'worker' under the OSH Code?"
      options={[
        { value: "yes", label: "Yes" },
        { value: "no", label: "No" }
      ]}
      help={`Not a worker: managerial or administrative staff, and supervisors earning more than ${supervisorLimit}. It changes when leave must be paid, and only workers get retrenchment or closure compensation under the Industrial Relations Code.`}
    />

    <p class="group">Retrenchment or closure</p>
    <p class="group-help">For a worker with a year's service, retrenchment or closure compensation is worked out from the wages above: 15 days' average pay for each completed year, and any part over six months.</p>
    <Pick
      name="unavoidable"
      label="If the establishment is closing: is it because of circumstances beyond the employer's control?"
      options={[
        { value: "no", label: "No" },
        { value: "yes", label: "Yes" }
      ]}
      help={`Then closure compensation can't be more than ${capMonths}. Losses, unsold stock, or the end of a lease or licence don't count as unavoidable.`}
    />
    <Num
      name="severance"
      label="Severance or ex gratia beyond the law (optional)"
      prefix="₹"
      placeholder="0"
      help="What the company pays on top of statutory compensation, for example under a separation scheme or agreement. For anyone who isn't a worker, enter the whole severance here."
    />

    <p class="group">Other amounts</p>
    <Num name="lieu" label="Notice pay the employer pays in lieu (optional)" prefix="₹" placeholder="0" help="For retrenching a worker: one month's wages if one month's written notice wasn't given." />
    <Num name="dues" label="Other dues (optional)" prefix="₹" placeholder="0" help="Bonus, incentives, reimbursements or arrears that are due." />
    <Num name="recovery" label="Notice shortfall to recover (optional)" prefix="₹" placeholder="0" help="Work this out as the contract says; the components and the number of days in a month differ between contracts." />
    <Num name="loans" label="Loans and advances to recover (optional)" prefix="₹" value="10,000" />
    <Num name="other" label="Other recoveries (optional)" prefix="₹" placeholder="0" help="For example the agreed value of assets not returned." />

    <p class="group">Deductions from the final pay</p>
    <Pick
      name="pf"
      label="Employee's PF on the final month's wages"
      style="select"
      value="restricted"
      options={[
        { value: "restricted", label: `12% of wages up to ${pfCeiling}` },
        { value: "actual", label: "12% of actual wages" },
        { value: "none", label: "Not a PF member" }
      ]}
      help="Worked out on the wages above for the payable days. PF isn't deducted from leave encashment, gratuity or compensation."
    />
    <Pick
      name="esi"
      label="Is the employee covered by ESI this contribution period?"
      options={[
        { value: "no", label: "No" },
        { value: "yes", label: "Yes" }
      ]}
    />
    <Pick name="state" label="State, for professional tax" style="select" options={PT_PICKER} value="KA" help="Worked out on the final month's salary." />
    <div data-ff-gender>
      <Pick
        name="gender"
        label="Employee's gender"
        options={[
          { value: "woman", label: "Woman" },
          { value: "other", label: "Man or other" }
        ]}
        value="other"
        help="Maharashtra charges women less."
      />
    </div>

    <p class="group">Income tax (TDS), an estimate</p>
    <Pick
      name="regime"
      label="Tax regime the employee chose"
      options={[
        { value: "new", label: "New (default)" },
        { value: "old", label: "Old" },
        { value: "none", label: "Don't estimate" }
      ]}
    />
    <Num
      name="ytd"
      label="Taxable salary already paid this tax year (optional)"
      prefix="₹"
      placeholder="From the monthly gross"
      help="Gross salary from 1 April (or joining) to the end of the month before the last one, plus any bonus paid. Leave blank to use the monthly gross for each earlier month."
    />
    <Num
      name="tdsytd"
      label="TDS already deducted this tax year (optional)"
      prefix="₹"
      placeholder="Estimated"
      help="From payroll. Leave blank to assume payroll spread a full year's tax evenly."
    />
    <div data-ff-old>
      <Num
        name="ded"
        label="Old regime: exemptions and deductions for the year"
        prefix="₹"
        placeholder="0"
        help="HRA exemption, professional tax paid in earlier months, and Form 124 deductions such as PF, insurance and home-loan interest. Professional tax for the final month is added for you."
      />
      <Pick
        name="age"
        label="Old regime: age during the tax year"
        options={[
          { value: "below60", label: "Below 60" },
          { value: "60to79", label: "60 to 79" },
          { value: "80plus", label: "80 or more" }
        ]}
      />
    </div>

    <p class="group">Working days, for the due dates</p>
    <Pick name="off" label="Weekly offs" style="select" value="sat_sun" options={Object.entries(WEEKLY_OFF_LABELS).map(([value, label]) => ({ value, label }))} />
    <div class="field">
      <label class="field-label" for="f-ff-holidays">Holidays after the last day (optional)</label>
      <textarea class="control" id="f-ff-holidays" name="holidays" rows="2" placeholder="For example 25 Dec 2026" aria-describedby="f-ff-holidays-help"></textarea>
      <span class="field-help" id="f-ff-holidays-help">One date per line. Holidays move the two-working-day deadline.</span>
    </div>
  </Fragment>
  <Fragment slot="headline">
    <span class="big" data-out="net">₹0</span>
    <span class="sub" data-out="sub"></span>
  </Fragment>
</CalcShell>
<AsAt
  ids={[
    "wages.separationPayDays",
    "leave.exitPaymentWorkingDays",
    "leave.retirementPaymentMonths",
    "gratuity.daysPerYear",
    "gratuity.divisor",
    "gratuity.minYears",
    "gratuity.fixedTermMinYears",
    "gratuity.ceiling",
    "gratuity.paymentDays",
    "osh.supervisorWageLimit",
    "notice.retrenchmentNoticeMonths",
    "notice.retrenchmentCompensationDays",
    "notice.closureCompensationCapMonths",
    "notice.reskillingFundDays",
    "notice.layoffPermissionWorkers",
    "epf.employeeRate",
    "epf.wageCeiling",
    "esi.employeeRate",
    "tax.stdDeductionNew",
    "tax.stdDeductionOld",
    "tax.rebateLimitNew",
    "tax.cess",
    "gratuity.taxExemptionLimit",
    "tax.leaveEncashmentExemption",
    "tax.retrenchmentExemption"
  ]}
  note="Professional tax uses the state slabs on the professional tax calculator page. Income-tax slabs for 2026-27 are in the TDS handbook, chapter 2."
/>

<script>
  import { bindCalculator, inr, num, type CalcLine, type CalcStep } from "../../scripts/calc-kit";
  import { computeFnf, SEPARATION_LABELS } from "../../lib/calc/full-and-final";
  import type { FnfTaxInput, PayBasis, SeparationType } from "../../lib/calc/full-and-final";
  import { gratuityRules } from "../../lib/calc/gratuity";
  import type { EmploymentType } from "../../lib/calc/gratuity";
  import type { AgeBand, Regime } from "../../lib/calc/income-tax";
  import type { Gender } from "../../lib/calc/professional-tax";
  import { addMonthsClamped, longDate, parseHolidays, parseISO, shortDate, WEEKLY_OFF_LABELS } from "../../lib/calc/working-days";
  import type { WeeklyOff } from "../../lib/calc/working-days";
  import { stat, statNum } from "../../data/statutory";

  const caveat = stat("wages.separationPayDays").note ?? "";
  const gr = gratuityRules();
  const codesFrom = stat("wages.halfRule").from ?? "2025-11-21";
  const nearMissDays = statNum("gratuity.continuousServiceDays");
  const compDays = statNum("notice.retrenchmentCompensationDays");
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;
  const minus = (n: number) => `− ${inr(n)}`;

  // Show the gender choice only for Maharashtra, and the old-regime inputs only for the old regime.
  const root = document.querySelector<HTMLElement>('[data-calc="full-and-final"]');
  const genderField = root?.querySelector<HTMLElement>("[data-ff-gender]");
  const oldFields = root?.querySelector<HTMLElement>("[data-ff-old]");
  const syncFields = () => {
    const form = root?.querySelector("form");
    if (!form) return;
    const state = (form.elements.namedItem("state") as HTMLSelectElement | null)?.value;
    const regime = (form.elements.namedItem("regime") as RadioNodeList | null)?.value;
    if (genderField) genderField.hidden = state !== "MH";
    if (oldFields) oldFields.hidden = regime !== "old";
  };
  root?.addEventListener("change", syncFields);

  bindCalculator("full-and-final", (v) => {
    const separation = v.str("exit", "resignation") as SeparationType;
    const paidRaw = v.raw("paid").replace(/[,\s]/g, "");
    const ytdRaw = v.raw("ytd").replace(/[₹,\s]/g, "");
    const tdsRaw = v.raw("tdsytd").replace(/[₹,\s]/g, "");
    const regime = v.str("regime", "new");
    const tax: FnfTaxInput | null =
      regime === "none"
        ? null
        : {
            regime: regime as Regime,
            age: v.str("age", "below60") as AgeBand,
            salaryBefore: ytdRaw === "" ? null : v.num("ytd"),
            tdsBefore: tdsRaw === "" ? null : v.num("tdsytd"),
            deductions: v.num("ded")
          };
    const r = computeFnf({
      separation,
      employment: v.str("type", "permanent") as EmploymentType,
      worker: v.str("worker", "yes") === "yes",
      doj: v.str("doj"),
      lwd: v.str("lwd"),
      monthlyGross: v.num("gross"),
      paidDays: paidRaw === "" ? null : v.num("paid"),
      payBasis: v.str("basis", "calendar") as PayBasis,
      wages: v.num("wages"),
      leaveDays: v.num("leave"),
      leaveDivisor: v.str("ldiv", "26") === "30" ? 30 : 26,
      noticePayInLieu: v.num("lieu"),
      otherDues: v.num("dues"),
      noticeRecovery: v.num("recovery"),
      loans: v.num("loans"),
      otherRecoveries: v.num("other"),
      weeklyOff: v.str("off", "sat_sun") as WeeklyOff,
      holidays: parseHolidays(v.raw("holidays")).dates,
      severance: v.num("severance"),
      closureUnavoidable: v.str("unavoidable", "no") === "yes",
      pf: v.str("pf", "restricted") as "restricted" | "actual" | "none",
      esi: v.str("esi", "no") === "yes",
      ptState: v.str("state", "KA"),
      gender: v.str("gender", "other") as Gender,
      tax
    });
    if (r.status !== "ok") return { outputs: { net: "₹0", sub: "" }, message: r.message };

    const g = r.gratuity;
    const c = r.compensation;
    const t = r.tax;
    const isRetrench = separation === "retrenchment" || separation === "closure";
    const compLabel = separation === "closure" ? "Closure compensation" : "Retrenchment compensation";
    const gratuityNote =
      g.status !== "ok" ? "Not worked out: see the gratuity calculator" : g.eligible ? `${g.countedYears} years counted` : `${g.service.years} completed years; ${g.minYears} needed`;
    const compNote = c.applies
      ? `${compDays} days × ${plural(c.years, "year")} at ${inr(Math.round(c.dailyRate))} a day${c.capped ? `, capped at ${stat("notice.closureCompensationCapMonths").display}` : ""}`
      : c.reason === "not-worker"
        ? "Only for workers; see severance"
        : c.reason === "under-a-year"
          ? "Less than a year's continuous service"
          : "Enter the monthly wages";
    const negative = r.net < 0;
    const lieu = v.num("lieu");
    const otherDues = v.num("dues");
    const pt = r.statutory.pt;

    const lines: CalcLine[] = [
      { label: "Salary for the last month", value: inr(r.salary.amount), note: `${num(r.salary.days, 1)} of ${r.salary.divisor} days${r.salary.defaulted ? ", from the dates" : ""}` },
      { label: "Leave encashment", value: inr(r.leave.amount), note: `${num(v.num("leave"), 1)} days at ${inr(Math.round(r.leave.dailyRate))} a day` },
      { label: "Gratuity", value: inr(r.gratuityAmount), note: gratuityNote },
      ...(isRetrench ? [{ label: compLabel, value: inr(c.amount), note: compNote, key: "compensation" }] : []),
      ...(r.severance > 0 ? [{ label: "Severance or ex gratia", value: inr(r.severance) }] : []),
      ...(lieu > 0 ? [{ label: "Notice pay in lieu", value: inr(lieu) }] : []),
      ...(otherDues > 0 ? [{ label: "Other dues", value: inr(otherDues) }] : []),
      { label: "Total dues", value: inr(r.dues), strong: true },
      ...(r.statutory.pf > 0 ? [{ label: "Employee's PF", value: minus(r.statutory.pf), note: `12% of ${inr(r.statutory.pfBase)}`, tone: "bad" as const }] : []),
      ...(r.statutory.esi > 0 ? [{ label: "Employee's ESI", value: minus(r.statutory.esi), tone: "bad" as const }] : []),
      ...(pt > 0 ? [{ label: "Professional tax", value: minus(pt), note: "On the final month's salary", tone: "bad" as const }] : []),
      ...(t
        ? [
            {
              label: "Income tax (TDS), estimate",
              value: t.tds > 0 ? minus(t.tds) : "₹0",
              note:
                t.tds > 0
                  ? `Tax for the year ${inr(t.year.total)} less ${inr(t.tdsBefore)} already deducted`
                  : t.excess > 0
                    ? `${inr(t.excess)} more was deducted earlier than the year's tax`
                    : t.year.total === 0 && t.year.regime === "new" && t.year.taxableIncome <= statNum("tax.rebateLimitNew")
                      ? `Taxable income for the year, ${inr(t.year.taxableIncome)}, is within the ${stat("tax.rebateLimitNew").display} rebate`
                      : t.year.total === 0
                        ? "No tax for the year"
                        : "Already deducted in earlier months",
              tone: t.tds > 0 ? ("bad" as const) : undefined,
              key: "tds"
            }
          ]
        : []),
      ...(r.deductions > 0 ? [{ label: "Total deductions", value: minus(r.deductions) }] : []),
      ...(v.num("recovery") > 0 ? [{ label: "Notice shortfall recovery", value: minus(v.num("recovery")), tone: "bad" as const }] : []),
      ...(v.num("loans") > 0 ? [{ label: "Loans and advances", value: minus(v.num("loans")), tone: "bad" as const }] : []),
      ...(v.num("other") > 0 ? [{ label: "Other recoveries", value: minus(v.num("other")), tone: "bad" as const }] : []),
      ...(r.recoveries > 0 ? [{ label: "Total recoveries", value: minus(r.recoveries) }] : []),
      { label: negative ? "Employee owes" : "Net payable", value: inr(Math.abs(r.net)), strong: true },
      ...(t ? [{ label: "Taxable part of the settlement", value: inr(t.settlementTaxable), note: `Exempt: ${inr(t.exempt.leave + t.exempt.gratuity + t.exempt.compensation)}`, key: "taxable" }] : []),
      ...(r.reskilling > 0 ? [{ label: "Employer pays to the re-skilling fund", value: inr(r.reskilling), note: "Not taken from the settlement: the fund credits the worker", key: "reskilling" }] : []),
      { label: "Pay wages by", value: r.due.wages.date ? longDate(r.due.wages.date) : "Normal pay date", note: r.due.wages.rule },
      ...(r.due.compensation?.date ? [{ label: `Pay ${compLabel.toLowerCase()} on`, value: longDate(r.due.compensation.date), note: r.due.compensation.rule }] : []),
      { label: "Pay leave encashment by", value: r.due.leave.date ? longDate(r.due.leave.date) : "With final wages", note: r.due.leave.rule },
      ...(r.gratuityAmount > 0 ? [{ label: "Pay gratuity by", value: longDate(r.due.gratuity.date!), note: r.due.gratuity.rule }] : [])
    ];

    const notes = [
      caveat,
      ...(r.due.wages.date ? [] : [`${SEPARATION_LABELS[separation]}: ${r.due.wages.text}.`]),
      ...(g.status === "not-covered" && g.message ? [g.message] : []),
      ...(r.statutory.ptNote ? [r.statutory.ptNote] : []),
      ...(t
        ? [
            "TDS is an estimate for a resident employee. It uses the reported exemption limits for gratuity, leave encashment and retrenchment compensation, which the Income-tax Act, 2025 carries over; confirm them, and any exemption the employee used with an earlier employer, with your tax adviser.",
            ...(r.severance > 0 && !c.applies
              ? ["Severance for someone who isn't a 'worker' is taxable salary. The employee may be able to claim relief for it in the return; that isn't applied here."]
              : []),
            "A recovery for notice not served reduces what is paid, but it isn't taken off taxable salary here; take advice before doing so."
          ]
        : separation === "death"
          ? ["Amounts paid to the legal heirs of an employee who has died are not their salary, so no TDS on salary is worked out."]
          : ["Income tax (TDS) is not estimated. Choose a regime above to see it."]),
      ...(isRetrench && c.applies
        ? [
            `Industrial establishments with ${stat("notice.layoffPermissionWorkers").display} or more need the government's permission before retrenchment or closure, and must give three months' notice or wages in lieu.`
          ]
        : []),
      "PF withdrawal or transfer is a claim the employee makes to EPFO; it is not part of the employer's settlement."
    ];

    // How this was worked out, step by step, with the numbers used.
    const lwd = v.str("lwd");
    const off = v.str("off", "sat_sun") as WeeklyOff;
    const holidaysTyped = parseHolidays(v.raw("holidays")).dates.length;
    const skipNote = `Skips ${WEEKLY_OFF_LABELS[off] ?? "weekly offs"}${holidaysTyped ? " and the holidays listed" : ""}`;
    const plus = (xs: number[]) => xs.filter((n) => n > 0).map((n) => inr(n)).join(" + ") || "₹0";
    const ldiv = v.str("ldiv", "26") === "30" ? 30 : 26;
    const working: CalcStep[] = [
      {
        label: "Salary for the last month",
        formula: `${inr(v.num("gross"))} ÷ ${r.salary.divisor} × ${num(r.salary.days, 1)} days`,
        result: inr(r.salary.amount),
        note: r.salary.defaulted ? "Payable days counted from the dates" : undefined
      },
      { label: "Leave encashment", formula: `${inr(v.num("wages"))} ÷ ${ldiv} × ${num(v.num("leave"), 1)} days`, result: inr(r.leave.amount) },
      g.status === "ok" && g.eligible && r.gratuityAmount > 0
        ? {
            label: "Gratuity",
            formula: `${inr(v.num("wages"))} × ${gr.daysPerYear} ÷ ${gr.divisor} × ${plural(g.countedYears, "year")}${g.capped ? `, capped at ${inr(gr.ceiling)}` : ""}`,
            result: inr(r.gratuityAmount)
          }
        : { label: "Gratuity", formula: "", result: "₹0", note: gratuityNote },
      ...(isRetrench
        ? [
            c.applies
              ? {
                  label: compLabel,
                  formula: `${inr(v.num("wages"))} ÷ ${ldiv} × ${compDays} days × ${plural(c.years, "year")}${c.capped ? `, capped at ${inr(c.amount)}` : ""}`,
                  result: inr(c.amount),
                  note: "Completed years, and one more for a part over six months"
                }
              : { label: compLabel, formula: "", result: "₹0", note: compNote }
          ]
        : []),
      { label: "Total dues", formula: plus([r.salary.amount, r.leave.amount, r.gratuityAmount, c.amount, r.severance, lieu, otherDues]), result: inr(r.dues) },
      ...(r.statutory.pf > 0 ? [{ label: "Employee's PF", formula: `12% × ${inr(r.statutory.pfBase)}`, result: inr(r.statutory.pf), note: "Wages for the payable days, up to the ceiling if restricted" }] : []),
      ...(t
        ? [
            {
              label: "Taxable salary for the year",
              formula: `${inr(t.salaryBefore)} paid before + ${inr(t.settlementTaxable)} taxable in the settlement`,
              result: inr(t.year.salary),
              note: t.salaryBeforeDefaulted ? `Earlier pay assumed: ${inr(v.num("gross"))} × ${plural(t.months, "month")}` : undefined
            },
            ...(t.exempt.leave + t.exempt.gratuity + t.exempt.compensation > 0
              ? [
                  {
                    label: "Exempt from tax",
                    formula: [
                      t.exempt.gratuity > 0 ? `gratuity ${inr(t.exempt.gratuity)}` : "",
                      t.exempt.leave > 0 ? `leave encashment ${inr(t.exempt.leave)}` : "",
                      t.exempt.compensation > 0 ? `compensation ${inr(t.exempt.compensation)}` : ""
                    ]
                      .filter(Boolean)
                      .join(" + "),
                    result: inr(t.exempt.leave + t.exempt.gratuity + t.exempt.compensation),
                    note: "Least of the amount paid and the reported limits"
                  }
                ]
              : []),
            {
              label: "Taxable income",
              formula: `${inr(t.year.salary)} − ${inr(t.year.standardDeduction)} standard deduction${t.year.deductions > 0 ? ` − ${inr(t.year.deductions)} deductions` : ""}`,
              result: inr(t.year.taxableIncome),
              note: `${t.year.regime === "new" ? "New" : "Old"} regime`
            },
            {
              label: "Tax for the year",
              formula: [
                `${inr(Math.round(t.year.slabTax))} at slab rates`,
                t.year.rebate > 0 ? `− ${inr(Math.round(t.year.rebate))} rebate` : "",
                t.year.marginalRelief > 0 ? `− ${inr(Math.round(t.year.marginalRelief))} marginal relief` : "",
                t.year.surcharge > 0 ? `+ ${inr(Math.round(t.year.surcharge))} surcharge` : "",
                t.year.cess > 0 ? `+ ${inr(Math.round(t.year.cess))} cess` : ""
              ]
                .filter(Boolean)
                .join(" "),
              result: inr(t.year.total)
            },
            {
              label: "TDS on the settlement",
              formula: `${inr(t.year.total)} − ${inr(t.tdsBefore)} already deducted`,
              result: inr(t.tds),
              note: t.tdsBeforeDefaulted ? "TDS so far assumed: a full year's tax spread evenly over the months" : t.excess > 0 ? "Deducted earlier is more than the year's tax: nothing more to deduct" : undefined
            }
          ]
        : []),
      ...(r.deductions > 0 ? [{ label: "Total deductions", formula: plus([r.statutory.pf, r.statutory.esi, pt, t?.tds ?? 0]), result: inr(r.deductions) }] : []),
      ...(r.recoveries > 0
        ? [
            [v.num("recovery"), v.num("loans"), v.num("other")].filter((n) => n > 0).length > 1
              ? { label: "Total recoveries", formula: plus([v.num("recovery"), v.num("loans"), v.num("other")]), result: inr(r.recoveries) }
              : { label: "Total recoveries", formula: "", result: inr(r.recoveries), note: v.num("loans") > 0 ? "Loans and advances" : v.num("recovery") > 0 ? "Notice shortfall" : "Other recoveries" }
          ]
        : []),
      { label: negative ? "Employee owes" : "Net payable", formula: `${inr(r.dues)} − ${inr(r.deductions)} − ${inr(r.recoveries)}`, result: inr(Math.abs(r.net)) },
      ...(r.due.wages.date
        ? [{ label: "Pay wages by", formula: `${shortDate(lwd)} + ${stat("wages.separationPayDays").display}`, result: longDate(r.due.wages.date), note: skipNote }]
        : []),
      ...(r.due.leave.date
        ? [
            separation === "superannuation" || separation === "death"
              ? { label: "Pay leave encashment by", formula: `${shortDate(lwd)} + ${statNum("leave.retirementPaymentMonths")} months`, result: longDate(r.due.leave.date) }
              : { label: "Pay leave encashment by", formula: `${shortDate(lwd)} + ${plural(statNum("leave.exitPaymentWorkingDays"), "working day")}`, result: longDate(r.due.leave.date), note: skipNote }
          ]
        : []),
      ...(r.gratuityAmount > 0 && r.due.gratuity.date ? [{ label: "Pay gratuity by", formula: `${shortDate(lwd)} + ${gr.paymentDays} days`, result: longDate(r.due.gratuity.date) }] : [])
    ];

    // Unusual inputs, using rules the page and the inputs' own definitions state.
    const warnings: string[] = [];
    const gross = v.num("gross");
    const wages = v.num("wages");
    if (gross > 0 && wages > gross)
      warnings.push(`Wages for gratuity and leave (${inr(wages)}) are more than the monthly gross salary (${inr(gross)}). Wages are part of gross pay, so check the two figures.`);
    if (lieu > 0 && v.num("recovery") > 0)
      warnings.push(
        "Notice pay in lieu and a notice shortfall recovery are both entered. Usually only one applies: the employer pays in lieu when it ends the notice early, and recovers a shortfall when the employee leaves before serving it."
      );
    if (isRetrench && c.applies && lieu === 0)
      warnings.push(
        `A worker with a year's service must get ${stat("notice.retrenchmentNoticeMonths").display}'s written notice with the reasons, or wages for the notice period in lieu (Industrial Relations Code s.70(a)). If notice wasn't given, enter the wages in lieu.`
      );
    if (isRetrench && c.reason === "not-worker")
      warnings.push(
        "Retrenchment and closure compensation under the Industrial Relations Code is for workers. For managerial or administrative staff, pay what the contract, policy or separation agreement says, and enter it as severance."
      );
    if (isRetrench && c.reason === "under-a-year")
      warnings.push(
        "Less than a year of service, so no statutory compensation is included. A worker who worked 240 days or more in the previous 12 months can still count as having a year's continuous service; check attendance before settling."
      );
    if (separation === "closure" && v.str("unavoidable", "no") === "yes" && !c.capped && c.applies)
      warnings.push("Closure for unavoidable reasons is marked, but the compensation is already below the three-month cap, so it is unchanged.");
    if (paidRaw !== "" && v.num("paid") > r.salary.divisor)
      warnings.push(`${num(v.num("paid"), 1)} payable days is more than the ${r.salary.divisor} the pay basis allows for the month, so ${r.salary.divisor} are used.`);
    if (t && t.tdsBeforeDefaulted && t.excess > 0)
      warnings.push(
        `On the assumed TDS so far (${inr(t.tdsBefore)}), more tax was deducted earlier than the year's tax. Enter the TDS payroll actually deducted to check; any excess is claimed back in the employee's return, not refunded by the employer.`
      );
    if (g.status === "ok" && !g.eligible && separation !== "death" && v.str("type", "permanent") === "permanent" && g.service.years === g.minYears - 1) {
      const extra = parseISO(lwd)! - parseISO(addMonthsClamped(v.str("doj"), 12 * g.service.years).date)! + 1;
      if (extra >= nearMissDays)
        warnings.push(
          `${plural(g.service.years, "year")} and ${plural(extra, "day")} of service: just short of ${g.minYears} completed years, so no gratuity is included. Courts differed on near-misses like ${g.service.years} years and ${nearMissDays} days under the old law, and the point is not settled. Check the case with HR.`
        );
    }
    if (lwd < codesFrom)
      warnings.push(`The last working day is before ${shortDate(codesFrom)}, when the Labour Codes came into force. The amounts and due dates here follow the Codes; the earlier Acts applied before then.`);

    return {
      working,
      warnings,
      outputs: {
        net: negative ? `− ${inr(Math.abs(r.net))}` : inr(r.net),
        sub: [
          r.deductions > 0 ? `After ${inr(r.deductions)} of PF, ESI, professional tax and TDS.` : "",
          r.due.wages.date ? `Pay wages by ${longDate(r.due.wages.date)}, within ${stat("wages.separationPayDays").display} of the last working day.` : r.due.wages.text + "."
        ]
          .filter(Boolean)
          .join(" ")
      },
      lines,
      bars: [
        { label: "Salary", value: r.salary.amount, display: inr(r.salary.amount) },
        { label: "Leave", value: r.leave.amount, display: inr(r.leave.amount) },
        { label: "Gratuity", value: r.gratuityAmount, display: inr(r.gratuityAmount) },
        ...(c.amount + r.severance > 0 ? [{ label: "Compensation", value: c.amount + r.severance, display: inr(c.amount + r.severance) }] : []),
        ...(r.deductions > 0 ? [{ label: "Deductions", value: r.deductions, display: minus(r.deductions) }] : []),
        { label: "Recoveries", value: r.recoveries, display: minus(r.recoveries) }
      ],
      notes
    };
  });
  // After bindCalculator has restored a shared link's values.
  syncFields();
</script>

