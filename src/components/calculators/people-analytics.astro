---
/**
 * People analytics: load an employee list (CSV or Excel), check the columns,
 * read the dashboard. Everything runs in the browser; see
 * src/components/analytics/app.ts for the behaviour and src/lib/analytics/
 * for the tested logic.
 */
import Icon from "../ui/Icon.astro";
import ChartCard from "../analytics/ChartCard.astro";
---

<div class="pa" data-pa>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <!-- Icons the script clones into the data checks, so it doesn't ship the whole icon set. -->
  <template data-icon="alert"><Icon name="alert" size={16} /></template>
  <template data-icon="x-circle"><Icon name="x-circle" size={16} /></template>
  <template data-icon="info"><Icon name="info" size={16} /></template>
  <template data-icon="check-circle"><Icon name="check-circle" size={16} /></template>
  <template data-icon="chevron-down"><Icon name="chevron-down" size={16} /></template>

  <!-- Step 1: load -->
  <section class="pa-step pa-load" data-step="load" aria-labelledby="pa-load-title">
    <div class="pa-load-main">
      <div>
        <p class="pa-stepno">Step 1 of 3</p>
        <h2 class="pa-h" id="pa-load-title" tabindex="-1">Load your employee list</h2>
      </div>
      <div class="pa-saved" data-saved hidden>
        <Icon name="history" size={20} />
        <p class="pa-saved-text"><strong>Kept in this browser:</strong> <span data-saved-text></span></p>
        <div class="pa-saved-actions">
          <button class="btn btn-sm" type="button" data-saved-open>Open it</button>
          <button class="btn btn-ghost btn-sm" type="button" data-saved-delete>Delete it</button>
        </div>
      </div>
      <div class="pa-drop" data-drop>
        <span class="pa-drop-icon"><Icon name="upload" size={26} /></span>
        <p class="pa-drop-title">Drop a CSV or Excel file here</p>
        <p class="pa-drop-sub">One row per person: everyone on the rolls, plus everyone who left during the period you want to look at.</p>
        <div class="pa-drop-actions">
          <button class="btn" type="button" data-pick><Icon name="file-text" size={18} /> Choose a file</button>
          <button class="btn btn-secondary" type="button" data-sample><Icon name="sparkle" size={18} /> Try with sample data</button>
        </div>
        <input type="file" accept=".csv,.txt,.xlsx,.xlsm,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" data-file hidden />
        <p class="pa-busy" data-busy hidden>Reading the file…</p>
        <p class="pa-error" role="alert" data-load-error hidden></p>
      </div>
    </div>
    <aside class="pa-privacy" aria-labelledby="pa-privacy-title">
      <p class="pa-privacy-title" id="pa-privacy-title"><Icon name="lock" size={18} /> Your data stays on this device</p>
      <ul>
        <li>Your browser reads the file. It is not uploaded to PeopleCraft or anyone else.</li>
        <li>Nothing is saved unless you tick <em>Keep this data in this browser</em>.</li>
        <li>Reload or close the page and the data is gone.</li>
      </ul>
      <p class="pa-privacy-links">
        <button class="pa-linkbtn" type="button" data-template><Icon name="download" size={16} /> Download a blank template (CSV)</button>
        <a class="pa-linkbtn" href="#how-to-prepare-your-file"><Icon name="checklist" size={16} /> How to prepare your file</a>
      </p>
    </aside>
  </section>

  <!-- Step 2: check the columns -->
  <section class="pa-step pa-map" data-step="map" aria-labelledby="pa-map-title" hidden>
    <div>
      <p class="pa-stepno">Step 2 of 3</p>
      <h2 class="pa-h" id="pa-map-title" tabindex="-1">Check the columns</h2>
      <p class="pa-lede" data-map-summary></p>
    </div>
    <div class="field pa-sheet" data-sheet-wrap hidden>
      <label class="field-label" for="pa-sheet">Sheet with the employee list</label>
      <select class="control" id="pa-sheet" data-sheet></select>
    </div>
    <div class="pa-map-table">
      <div class="pa-map-row pa-map-head" aria-hidden="true">
        <span>What the dashboard needs</span><span>Column in your file</span><span>First values in that column</span>
      </div>
      <div data-map-rows></div>
    </div>
    <div class="pa-map-options">
      <div class="field">
        <label class="field-label" for="pa-dateorder">Dates like 03/04/2025 are</label>
        <select class="control" id="pa-dateorder" data-dateorder aria-describedby="pa-dateorder-help">
          <option value="dmy">Day first: 3 April 2025 (usual in India)</option>
          <option value="mdy">Month first: 4 March 2025</option>
        </select>
        <span class="field-help" id="pa-dateorder-help" data-dateorder-help>Dates written as 2025-04-03 or 3-Apr-2025 are read correctly either way.</span>
      </div>
      <div class="field" data-salaryunit-wrap hidden>
        <label class="field-label" for="pa-salaryunit">The salary column is</label>
        <select class="control" id="pa-salaryunit" data-salaryunit>
          <option value="annual">Yearly (annual CTC)</option>
          <option value="monthly">Monthly (gross or CTC per month)</option>
        </select>
      </div>
    </div>
    <fieldset class="pa-status" data-status-wrap hidden>
      <legend class="field-label">How should each status count?</legend>
      <p class="field-help">The last working day decides when someone left. Status is a cross-check: it catches leavers with no date and dates that clash with the status.</p>
      <div class="pa-status-rows" data-status-rows></div>
    </fieldset>
    <p class="pa-error" role="alert" data-map-error hidden></p>
    <div class="pa-map-actions">
      <button class="btn" type="button" data-show>Show the dashboard <Icon name="arrow-right" size={18} /></button>
      <button class="btn btn-ghost" type="button" data-restart>Choose a different file</button>
    </div>
  </section>

  <!-- Step 3: dashboard -->
  <section class="pa-step pa-dash" data-step="dash" aria-labelledby="pa-dash-title" hidden>
    <div class="pa-dash-head">
      <div>
        <p class="pa-stepno" data-print="hide">Step 3 of 3</p>
        <h2 class="pa-h" id="pa-dash-title" tabindex="-1">Your dashboard</h2>
        <p class="pa-source" data-source></p>
      </div>
      <div class="pa-actions" data-print="hide">
        <button class="btn btn-secondary btn-sm" type="button" data-export><Icon name="download" size={16} /> Export summary (CSV)</button>
        <button class="btn btn-ghost btn-sm" type="button" data-print-btn><Icon name="printer" size={16} /> Print</button>
        <button class="btn btn-ghost btn-sm" type="button" data-remap><Icon name="sliders" size={16} /> Check columns</button>
        <button class="btn btn-ghost btn-sm" type="button" data-new><Icon name="upload" size={16} /> Load another file</button>
      </div>
    </div>

    <div class="pa-sample-note" data-sample-note hidden>
      <span class="chip chip-accent">Sample data</span>
      <p>A made-up company of about 120 people, with everyone who has left since it started. The names are invented. It includes a few deliberate mistakes so you can see the data checks at work.</p>
    </div>
    <label class="pa-keep" data-keep-wrap hidden data-print="hide">
      <input type="checkbox" data-keep />
      <span>Keep this data in this browser <span class="pa-keep-note">(on this device only, until you untick this; leave it unticked on a shared computer)</span></span>
    </label>

    <form class="pa-filters" data-filters aria-label="Filters" data-print="hide">
      <div class="field pa-f-period">
        <label class="field-label" for="pa-period">Period</label>
        <select class="control" id="pa-period" data-period></select>
      </div>
      <div class="pa-custom" data-custom hidden>
        <div class="field">
          <label class="field-label" for="pa-from">From</label>
          <select class="control" id="pa-from" data-from></select>
        </div>
        <div class="field">
          <label class="field-label" for="pa-to">To</label>
          <select class="control" id="pa-to" data-to></select>
        </div>
      </div>
      <div class="field">
        <label class="field-label" for="pa-dept">Department</label>
        <select class="control" id="pa-dept" data-dept></select>
      </div>
      <div class="field">
        <label class="field-label" for="pa-location">Location</label>
        <select class="control" id="pa-location" data-location></select>
      </div>
      <div class="field">
        <label class="field-label" for="pa-gender">Gender</label>
        <select class="control" id="pa-gender" data-gender></select>
      </div>
    </form>
    <p class="pa-scope" data-scope></p>
    <p class="pa-hint" data-hint hidden></p>
    <p class="pa-alert" data-quality-alert hidden></p>

    <dl class="pa-kpis">
      <div class="pa-kpi">
        <dt>Headcount</dt>
        <dd class="pa-kpi-v" data-kpi="headcount"></dd>
        <dd class="pa-kpi-s" data-kpi-sub="headcount"></dd>
      </div>
      <div class="pa-kpi">
        <dt>Joiners</dt>
        <dd class="pa-kpi-v" data-kpi="joiners"></dd>
        <dd class="pa-kpi-s" data-kpi-sub="joiners"></dd>
      </div>
      <div class="pa-kpi">
        <dt>Leavers</dt>
        <dd class="pa-kpi-v" data-kpi="leavers"></dd>
        <dd class="pa-kpi-s" data-kpi-sub="leavers"></dd>
      </div>
      <div class="pa-kpi pa-kpi-wide">
        <dt>Attrition rate</dt>
        <dd class="pa-kpi-v" data-kpi="rate"></dd>
        <dd class="pa-formula" data-kpi-sub="rate"></dd>
      </div>
      <div class="pa-kpi">
        <dt>Average tenure</dt>
        <dd class="pa-kpi-v" data-kpi="tenure"></dd>
        <dd class="pa-kpi-s" data-kpi-sub="tenure"></dd>
      </div>
      <div class="pa-kpi pa-kpi-wide">
        <dt>Gender ratio</dt>
        <dd class="pa-kpi-v" data-kpi="gender"></dd>
        <dd class="pa-kpi-s" data-kpi-sub="gender"></dd>
      </div>
    </dl>

    <div class="pa-grid">
      <ChartCard id="headcount" title="Headcount by month" caption="People on the rolls at the end of each month. The scale starts at zero, so small changes look small." />
      <ChartCard id="flow" title="Joiners and leavers by month" caption="Joiners by joining date, leavers by last working day. Someone who joins and leaves in the same month appears in both." />
      <ChartCard id="dept" wide title="Attrition by department" caption="Leavers ÷ average headcount × 100 for each department over the period. The vertical line is the rate for everyone shown. In a team of fewer than 10 people, one leaver moves the rate a lot." />
      <ChartCard id="tenure" title="Tenure" caption="Years of service of the people on the rolls at the end of the period. Darker bars are longer service." />
      <ChartCard id="span" title="Span of control" caption="Direct reports per manager, counting people on the rolls at the end of the period. There is no single right number: look for spans much narrower or wider than the rest, and ask why." />
      <ChartCard
        id="pay"
        wide
        title="Pay spread"
        caption="Salary or CTC as given in your file, for people on the rolls at the end of the period. Groups of fewer than 3 people are not shown, so no one's pay can be read off the chart. To compare like with like, use the <a href='/toolkit/pay-equity-analyzer/'>pay equity analyser</a>."
      >
        <div class="pa-seg" role="group" aria-label="Group pay by" slot="tools" data-payby>
          <button type="button" class="pa-seg-btn" data-payby-value="dept" aria-pressed="true">Department</button>
          <button type="button" class="pa-seg-btn" data-payby-value="grade" aria-pressed="false">Grade</button>
        </div>
      </ChartCard>
    </div>

    <section class="pa-quality" id="pa-quality" aria-labelledby="pa-quality-title">
      <div class="pa-quality-head">
        <h3 class="pa-card-title" id="pa-quality-title">Data checks</h3>
        <p class="pa-card-sub" data-quality-summary></p>
      </div>
      <div class="pa-checks" data-quality-list></div>
    </section>
  </section>
</div>

<script>
  import { mountPeopleAnalytics } from "../analytics/app";
  const root = document.querySelector<HTMLElement>("[data-pa]");
  if (root) mountPeopleAnalytics(root);
</script>

<style is:global>
  .pa {
    display: grid;
    gap: 1.5rem;
  }
  .pa-step {
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .pa-stepno {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
    letter-spacing: 0.01em;
  }
  .pa-h {
    font-size: var(--fs-xl);
    margin-top: 0.15rem;
  }
  .pa-h:focus {
    outline: none;
  }
  .pa-lede {
    margin-top: 0.4rem;
    color: var(--ink-2);
    max-width: 70ch;
  }
  .pa-error,
  .pa-alert,
  .pa-hint {
    padding: 0.7rem 0.9rem;
    border-radius: var(--r);
    font-size: var(--fs-sm);
    font-weight: 540;
  }
  .pa-error {
    background: var(--bad-soft);
    color: var(--bad);
  }
  .pa-alert {
    background: var(--warn-soft);
    color: var(--warn);
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .pa-alert a {
    color: inherit;
    font-weight: 650;
  }
  .pa-hint {
    background: var(--info-soft);
    color: var(--info);
  }
  .pa-busy {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  /* ---------- Step 1 ---------- */
  .pa-load {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
  }
  .pa-load-main {
    display: grid;
    gap: 1rem;
  }
  .pa-drop {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding: 2.25rem 1.25rem 2rem;
    text-align: center;
    border: 2px dashed var(--line-strong);
    border-radius: var(--r-xl);
    background: var(--canvas);
    transition: border-color 150ms, background-color 150ms;
  }
  .pa-drop.is-over {
    border-color: var(--primary);
    background: var(--neel-50);
  }
  .pa-drop-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--primary);
  }
  .pa-drop-title {
    font-weight: 650;
    font-size: var(--fs-md);
  }
  .pa-drop-sub {
    max-width: 46ch;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .pa-drop-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .pa-saved {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink-2);
  }
  .pa-saved-text {
    flex: 1 1 16rem;
    font-size: var(--fs-sm);
    color: var(--ink);
  }
  .pa-saved-actions {
    display: flex;
    gap: 0.4rem;
  }
  .pa-privacy {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.1rem;
    border-radius: var(--r-xl);
    background: var(--good-soft);
    border: 1px solid color-mix(in srgb, var(--good) 25%, transparent);
  }
  .pa-privacy-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    color: var(--good);
  }
  .pa-privacy ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--fs-sm);
  }
  .pa-privacy-links {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in srgb, var(--good) 20%, transparent);
  }
  .pa-linkbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    border: 0;
    background: none;
    color: var(--primary);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(59 68 166 / 0.35);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .pa-linkbtn:hover {
    text-decoration-color: currentColor;
  }

  /* ---------- Step 2 ---------- */
  .pa-map {
    display: grid;
    gap: 1.25rem;
  }
  .pa-sheet {
    max-width: 24rem;
  }
  .pa-map-table {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
    overflow: hidden;
  }
  .pa-map-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  [data-map-rows] > .pa-map-row:last-child {
    border-bottom: 0;
  }
  .pa-map-head {
    padding-block: 0.55rem;
    background: var(--canvas);
    font-size: var(--fs-xs);
    font-weight: 620;
    color: var(--ink-2);
  }
  .pa-map-field {
    display: grid;
    gap: 0.15rem;
  }
  .pa-map-field label {
    font-weight: 620;
    font-size: var(--fs-sm);
  }
  .pa-map-use {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    line-height: 1.4;
  }
  .pa-req {
    margin-left: 0.35rem;
    font-size: 0.75rem;
    font-weight: 620;
    color: var(--accent-ink);
    background: var(--accent-soft);
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    vertical-align: 1px;
  }
  .pa-map-row .control {
    min-height: 2.5rem;
    padding-block: 0.4rem;
    font-size: var(--fs-sm);
  }
  .pa-map-ex {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .pa-map-ex .pa-read {
    color: var(--ink-3);
  }
  .pa-map-ex.is-bad {
    color: var(--bad);
    font-weight: 560;
  }
  .pa-map-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem 1.5rem;
  }
  .pa-status {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .pa-status legend {
    padding: 0 0.3rem;
  }
  .pa-status-rows {
    display: grid;
    gap: 0.5rem;
  }
  .pa-status-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 15rem);
    gap: 0.75rem;
    align-items: center;
    font-size: var(--fs-sm);
  }
  .pa-status-row .control {
    min-height: 2.4rem;
    padding-block: 0.35rem;
    font-size: var(--fs-sm);
  }
  .pa-status-count {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .pa-map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* ---------- Step 3 ---------- */
  .pa-dash {
    display: grid;
    gap: 1.25rem;
  }
  .pa-dash-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .pa-source {
    margin-top: 0.25rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .pa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .pa-sample-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-radius: var(--r-lg);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    font-size: var(--fs-sm);
  }
  .pa-sample-note p {
    flex: 1 1 18rem;
  }
  .pa-keep {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-size: var(--fs-sm);
    font-weight: 560;
    cursor: pointer;
    justify-self: start;
  }
  .pa-keep input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--primary);
  }
  .pa-keep-note {
    font-weight: 430;
    color: var(--ink-3);
  }
  .pa-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--canvas);
  }
  .pa-filters .field {
    flex: 1 1 10rem;
    min-width: 0;
  }
  .pa-filters .pa-f-period {
    flex: 1.5 1 15rem;
  }
  .pa-filters .control {
    min-height: 2.6rem;
    padding-block: 0.4rem;
    font-size: var(--fs-sm);
  }
  .pa-custom {
    display: flex;
    gap: 0.75rem;
    flex: 2 1 16rem;
  }
  .pa-scope {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    margin-top: -0.35rem;
  }

  .pa-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .pa-kpi {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1rem 1.2rem 1.15rem;
    background: var(--paper);
    min-width: 0;
  }
  .pa-kpi dt {
    font-size: var(--fs-sm);
    font-weight: 620;
    color: var(--ink-2);
  }
  .pa-kpi dd {
    margin: 0;
  }
  .pa-kpi-v {
    font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.5rem);
    font-weight: 660;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--neel-800);
  }
  .pa-kpi-v .pa-unit {
    font-size: 0.5em;
    font-weight: 580;
    letter-spacing: 0;
