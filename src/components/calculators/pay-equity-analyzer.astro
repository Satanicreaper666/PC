---
import Icon from "../ui/Icon.astro";
import { MIN_GROUP } from "../../lib/calc/pay-equity-analyzer";
---

<div class="pe" data-pay-equity>
  <div class="pe-top">
    <section class="panel inputs" aria-labelledby="pe-in-title">
      <p class="panel-title" id="pe-in-title">Your data</p>

      <div class="field">
        <label class="field-label" for="pe-paste">Paste rows: role, gender, annual pay</label>
        <textarea class="control" id="pe-paste" rows="6" placeholder={"Software engineer\tWoman\t10,50,000\nSoftware engineer\tMan\t11,00,000\nSales executive\tF\t5,60,000"} aria-describedby="pe-paste-help"></textarea>
        <span class="field-help" id="pe-paste-help">Copy three columns from Excel or Google Sheets, or type them with commas. Pay can be written as 12,50,000 or 12.5 lakh. Leave names out; they aren't needed.</span>
      </div>
      <button class="btn btn-secondary" type="button" data-paste-add><Icon name="plus" size={18} /> Add these rows</button>
      <div class="file-row">
        <label class="btn btn-secondary btn-sm">
          <Icon name="file-text" size={16} /> Load an employee file
          <input class="visually-hidden" type="file" accept=".csv,.txt,.xlsx,.xlsm,text/csv" data-pe-file />
        </label>
        <button class="btn btn-secondary btn-sm" type="button" data-pe-shared hidden><Icon name="people" size={16} /> <span data-pe-shared-label>Use the file from another tool</span></button>
        <label class="pe-by">
          <span>Compare people by</span>
          <select class="control" data-pe-by>
            <option value="grade">Grade</option>
            <option value="designation">Designation</option>
          </select>
        </label>
      </div>
      <div class="msg" data-paste-msg role="status" hidden></div>

      <form class="one" data-one novalidate aria-labelledby="pe-one-title">
        <p class="sub-title" id="pe-one-title">Or add one person</p>
        <div class="field">
          <label class="field-label" for="pe-role">Role</label>
          <input class="control" id="pe-role" name="role" type="text" list="pe-roles" maxlength="80" autocomplete="off" placeholder="For example, Software engineer" />
          <datalist id="pe-roles" data-roles></datalist>
        </div>
        <div class="two">
          <div class="field">
            <label class="field-label" for="pe-gender">Gender</label>
            <select class="control" id="pe-gender" name="gender">
              <option value="woman">Woman</option>
              <option value="man">Man</option>
              <option value="other">Another gender or not stated</option>
            </select>
          </div>
          <div class="field">
            <label class="field-label" for="pe-pay">Annual pay</label>
            <input class="control" id="pe-pay" name="pay" type="text" inputmode="decimal" autocomplete="off" placeholder="₹ a year" />
          </div>
        </div>
        <p class="field-error" data-one-error hidden></p>
        <button class="btn btn-secondary" type="submit"><Icon name="plus" size={18} /> Add</button>
      </form>

      <div class="data-actions">
        <button class="btn btn-ghost btn-sm" type="button" data-example>Load an example</button>
        <button class="btn btn-ghost btn-sm" type="button" data-csv><Icon name="download" size={16} /> Download CSV</button>
        <button class="btn btn-ghost btn-sm" type="button" data-clear><Icon name="x" size={16} /> Clear all</button>
      </div>
      <label class="keep">
        <input type="checkbox" data-keep />
        <span>Keep this data in this browser on this device <span class="muted">(leave unticked on a shared computer)</span></span>
      </label>
      <p class="privacy"><Icon name="lock" size={16} /><span>Your data never leaves this browser: nothing is uploaded or sent anywhere. Unless you tick the box above, it is gone when you close the page.</span></p>
    </section>

    <section class="panel results" aria-labelledby="pe-out-title" aria-live="polite">
      <p class="panel-title" id="pe-out-title">Pay gaps</p>
      <p class="empty" data-empty>
        Add at least one woman and one man to see a gap, or <button type="button" class="linkish" data-example>load an example</button>.
      </p>
      <div data-out-area hidden>
        <p class="counts" data-counts></p>
        <dl class="kpis">
          <div class="kpi">
            <dt>Unadjusted gap, mean</dt>
            <dd><span class="kv" data-k="mean"></span><span class="kn" data-kn="mean"></span></dd>
          </div>
          <div class="kpi">
            <dt>Unadjusted gap, median</dt>
            <dd><span class="kv" data-k="median"></span><span class="kn" data-kn="median"></span></dd>
          </div>
          <div class="kpi accent">
            <dt>Like-for-like gap, same role</dt>
            <dd><span class="kv" data-k="lfl"></span><span class="kn" data-kn="lfl"></span></dd>
          </div>
        </dl>
        <div class="caution" data-caution>
          <Icon name="alert" size={18} />
          <div data-caution-text></div>
        </div>
        <div class="quart" data-quart>
          <p class="q-title">Women's share of each pay quarter</p>
          <ul class="legend" aria-hidden="true">
            <li><span class="sw c1"></span>Women</li>
            <li><span class="sw c2"></span>Men</li>
          </ul>
          <div class="q-rows" data-q-rows></div>
          <p class="q-note" data-q-note></p>
          <div class="tip" role="tooltip" hidden></div>
        </div>
      </div>
    </section>
  </div>

  <section class="panel roles" data-roles-area hidden aria-labelledby="pe-roles-title">
    <h2 class="t" id="pe-roles-title">Gaps within each role</h2>
    <p class="muted small">Positive gaps mean women in the role are paid less on average. Roles with fewer than {MIN_GROUP} women or {MIN_GROUP} men are marked; one person can move their average a lot.</p>
    <div class="tw" role="region" tabindex="0" aria-labelledby="pe-roles-title">
      <table class="rt">
        <caption class="visually-hidden">Number of women and men, average pay and gap for each role</caption>
        <thead>
          <tr>
            <th scope="col">Role</th>
            <th scope="col">Women</th>
            <th scope="col">Men</th>
            <th scope="col">Women's average</th>
            <th scope="col">Men's average</th>
            <th scope="col">Gap</th>
            <th scope="col">Read with care</th>
          </tr>
        </thead>
        <tbody data-role-rows></tbody>
      </table>
    </div>
    <div class="close" data-close hidden>
      <h3 class="t">Cost to close the gaps</h3>
      <p class="muted small" data-close-sum></p>
      <div class="tw" role="region" tabindex="0" aria-label="Cost to close by role">
        <table class="rt">
          <caption class="visually-hidden">For each role: women paid below the men's median, the median, and the yearly cost to raise them to it</caption>
          <thead>
            <tr><th scope="col">Role</th><th scope="col">Women below</th><th scope="col">Men's median</th><th scope="col">Cost a year</th><th scope="col">Read with care</th></tr>
          </thead>
          <tbody data-close-rows></tbody>
        </table>
      </div>
      <p class="tiny muted">Raises every woman paid below the men's median in her role to that median. A starting budget, not a decision: look at each case's experience, performance and location first. Employer PF and other on-costs come on top.</p>
    </div>
    <details class="rows">
      <summary>Your rows <span data-row-count></span></summary>
      <div class="tw" role="region" tabindex="0" aria-label="Your rows">
        <table class="dt">
          <caption class="visually-hidden">Every row you added</caption>
          <thead>
            <tr><th scope="col">Role</th><th scope="col">Gender</th><th scope="col">Annual pay</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr>
          </thead>
          <tbody data-data-rows></tbody>
        </table>
      </div>
      <p class="tiny muted" data-row-limit hidden></p>
    </details>
  </section>
</div>

<script>
  import { analyse, costToClose, parseRows, parsePay, cleanRole, normaliseGender, toCsv, GENDER_LABEL, EXAMPLE_ROWS, MIN_GROUP, type PayRow, type Gender, type Analysis } from "../../lib/calc/pay-equity-analyzer";
  import { sharedRoster } from "../../scripts/roster";

  const KEY = "peoplecraft:pay-equity:v1";
  const SHOW_ROWS = 300;
  const root = document.querySelector<HTMLElement>("[data-pay-equity]")!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const keep = $<HTMLInputElement>("[data-keep]");
  const inr = (n: number) => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(n);
  const pct = (n: number) => `${new Intl.NumberFormat("en-IN", { maximumFractionDigits: 1, minimumFractionDigits: 1 }).format(Math.abs(n))}%`;
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

  let rows: PayRow[] = [];
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) {
      const arr: unknown = JSON.parse(raw);
      if (Array.isArray(arr)) {
        rows = arr.filter((r) => r && typeof r.role === "string" && ["woman", "man", "other"].includes(r.gender) && typeof r.pay === "number" && r.pay > 0);
        keep.checked = true;
      }
    }
  } catch {
    /* storage unavailable: work in memory */
  }

  function persist() {
    try {
      if (keep.checked && rows.length) localStorage.setItem(KEY, JSON.stringify(rows));
      else localStorage.removeItem(KEY);
    } catch {
      /* ignore */
    }
  }
  function commit() {
    persist();
    render();
  }
  keep.addEventListener("change", persist);

  function gapWords(g: number | null, subject: string) {
    if (g === null) return "Needs at least one woman and one man.";
    if (Math.abs(g) < 0.05) return `No difference between women's and men's ${subject}.`;
    return g > 0 ? `Women's ${subject} is ${pct(g)} lower than men's.` : `Women's ${subject} is ${pct(g)} higher than men's.`;
  }
  function setKpi(key: string, g: number | null, note: string) {
    $(`[data-k="${key}"]`).textContent = g === null ? "—" : pct(g);
    $(`[data-kn="${key}"]`).textContent = note;
  }

  function render() {
    const a = analyse(rows);
    const hasGap = a.counts.women > 0 && a.counts.men > 0;
    $("[data-empty]").hidden = hasGap;
    $("[data-out-area]").hidden = !hasGap;
    $("[data-roles-area]").hidden = rows.length === 0;
    renderRoles(a);
    renderRows();
    const roles = new Set(rows.map((r) => r.role));
    $("[data-roles]").replaceChildren(...[...roles].sort().map((r) => Object.assign(document.createElement("option"), { value: r })));
    if (!hasGap) return;

    $("[data-counts]").textContent = `${plural(a.counts.total, "person", "people")}: ${a.counts.women} ${a.counts.women === 1 ? "woman" : "women"}, ${a.counts.men} ${a.counts.men === 1 ? "man" : "men"}${a.counts.other ? `, ${a.counts.other} another gender or not stated (not in the gap figures)` : ""}.`;
    setKpi("mean", a.overall.gapMean, gapWords(a.overall.gapMean, "average pay"));
    setKpi("median", a.overall.gapMedian, gapWords(a.overall.gapMedian, "median pay"));
    const l = a.likeForLike;
    const lflNote =
      l.gap === null
        ? "No role has both women and men to compare."
        : `${gapWords(l.gap, "pay in the same role")} Compares ${plural(l.women, "woman", "women")} with men in ${plural(l.roles, "role", "roles")}.`;
    setKpi("lfl", l.gap, lflNote);

    const caution: string[] = [];
    const compared = l.women + l.men;
    if (l.inSmallGroups > 0) caution.push(`${l.inSmallGroups} of the ${compared} people compared are in roles with fewer than ${MIN_GROUP} women or ${MIN_GROUP} men. In groups that small, one person can move an average a lot: treat those gaps as prompts to review individual cases, not as findings.`);
    if (a.likeForLikeLarge.roles > 0 && l.gap !== null && a.likeForLikeLarge.gap !== null && a.likeForLikeLarge.roles < l.roles)
      caution.push(`Using only the ${plural(a.likeForLikeLarge.roles, "role", "roles")} with at least ${MIN_GROUP} women and ${MIN_GROUP} men, the like-for-like gap is ${pct(a.likeForLikeLarge.gap)} (${a.likeForLikeLarge.gap >= 0 ? "women paid less" : "women paid more"}).`);
    if (l.womenNotCompared > 0) caution.push(`${plural(l.womenNotCompared, "woman is", "women are")} in roles with no men, so ${l.womenNotCompared === 1 ? "she isn't" : "they aren't"} in the like-for-like figure.`);
    caution.push("Same role is not the whole story: experience, performance, location and hours can explain a gap, or can themselves reflect bias. No statistical test is applied.");
    $("[data-caution-text]").replaceChildren(...caution.map((c) => Object.assign(document.createElement("p"), { textContent: c })));

    renderQuartiles(a);
    renderClose();
  }

  function renderQuartiles(a: Analysis) {
    const host = $("[data-q-rows]");
    const q = a.quartiles;
    $("[data-quart]").hidden = q.length === 0;
    if (!q.length) return;
    host.replaceChildren(
      ...q.map((x) => {
        const n = x.women + x.men;
        const w = n ? (x.women / n) * 100 : 0;
        const row = document.createElement("div");
        row.className = "q-row";
        const label = Object.assign(document.createElement("span"), { className: "q-label", textContent: x.label });
        const bar = document.createElement("span");
        bar.className = "q-bar";
        bar.tabIndex = 0;
        const desc = `${x.label}: ${plural(x.women, "woman", "women")} and ${plural(x.men, "man", "men")}, ${Math.round(w)}% women`;
        bar.setAttribute("role", "img");
        bar.setAttribute("aria-label", desc);
        bar.dataset.tip = desc;
        const parts: [number, string, string][] = [
          [w, "c1", "#fff"],
          [100 - w, "c2", "#151a3b"]
        ];
        for (const [share, c, ink] of parts) {
          if (share <= 0) continue;
          const s = document.createElement("span");
          s.className = `q-seg ${c}`;
          s.style.flexGrow = String(share);
          s.style.color = ink;
          const t = Object.assign(document.createElement("span"), { textContent: `${Math.round(share)}%` });
          s.append(t);
          bar.append(s);
        }
        row.append(label, bar);
        return row;
      })
    );
    requestAnimationFrame(() =>
      host.querySelectorAll<HTMLElement>(".q-seg").forEach((s) => {
        const t = s.firstElementChild as HTMLElement;
        t.hidden = false;
        t.hidden = t.offsetWidth + 10 > s.clientWidth;
      })
    );
    const share = a.counts.women / (a.counts.women + a.counts.men);
    $("[data-q-note]").textContent = `Women are ${Math.round(share * 100)}% of the people compared. If their share falls in the higher-paid quarters, the unadjusted gap is mostly about who holds which roles; the like-for-like gap shows pay for the same role.`;
  }

  function renderClose() {
    const c = costToClose(rows);
    $("[data-close]").hidden = c.roles.length === 0;
    if (!c.roles.length) return;
    $("[data-close-sum]").textContent = `${plural(c.women, "woman is", "women are")} paid below the men's median in their role. Raising them to it would cost ${inr(Math.round(c.cost))} a year, ${(c.share * 100).toFixed(2)}% of the payroll entered.`;
    $("[data-close-rows]").replaceChildren(
      ...c.roles.map((r) => {
        const tr = document.createElement("tr");
        const cells = [r.role, String(r.below), inr(Math.round(r.target)), inr(Math.round(r.cost)), r.small ? `Fewer than ${MIN_GROUP} women or men` : ""];
        cells.forEach((t, i) => tr.append(Object.assign(document.createElement(i === 0 ? "th" : "td"), { textContent: t })));
        return tr;
      })
    );
  }

  // Load an employee file: the role (grade or designation), gender and salary columns.
  type Cell = string | number | boolean | null;
  let fileTable: Cell[][] | null = null;
  const norm = (x: unknown) => String(x ?? "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
  function rowsFromTable(t: Cell[][]): { rows: PayRow[]; message: string } {
    const h = t.findIndex((r) => r.some((c) => c !== null && c !== ""));
    const head = (t[h] ?? []).map(norm);
    const find = (syns: string[]) => {
      for (const sy of syns) {
        const i = head.findIndex((x) => x === sy);
        if (i >= 0) return i;
      }
      for (const sy of syns) {
        const i = head.findIndex((x) => x.includes(sy));
        if (i >= 0) return i;
      }
      return -1;
    };
    const by = $<HTMLSelectElement>("[data-pe-by]").value;
    const roleCol = by === "grade" ? find(["grade", "level", "band", "job grade"]) : find(["designation", "job title", "title", "role"]);
    const genderCol = find(["gender", "sex"]);
    const payCol = find(["annual ctc", "ctc", "annual salary", "fixed pay", "salary", "gross annual", "pay"]);
    if (roleCol < 0 || genderCol < 0 || payCol < 0) {
      const miss = [roleCol < 0 ? by : "", genderCol < 0 ? "gender" : "", payCol < 0 ? "salary" : ""].filter(Boolean).join(", ");
      return { rows: [], message: `No ${miss} column was found. Name the columns as in your HRMS export (for example Grade, Gender, Annual CTC).` };
    }
    const out: PayRow[] = [];
    let skipped = 0;
    for (const r of t.slice(h + 1)) {
      if (!r.some((c) => c !== null && c !== "")) continue;
      const pay = typeof r[payCol] === "number" ? (r[payCol] as number) : parsePay(String(r[payCol] ?? ""));
      const role = cleanRole(String(r[roleCol] ?? ""));
      if (!pay || !role) {
        skipped++;
        continue;
      }
      out.push({ role, gender: normaliseGender(String(r[genderCol] ?? "")), pay });
    }
    return { rows: out, message: `Loaded ${plural(out.length, "person", "people")}, compared by ${by}.${skipped ? ` ${skipped} rows without a ${by} or salary were left out.` : ""} Names and IDs aren't used.` };
  }
  function loadTable(t: Cell[][]) {
    fileTable = t;
    const res = rowsFromTable(t);
    const msg = $("[data-paste-msg]");
    msg.hidden = false;
    msg.textContent = res.message;
    if (!res.rows.length) return;
    rows = res.rows;
    commit();
  }
  const shared = sharedRoster();
  if (shared) {
    $("[data-pe-shared]").hidden = false;
    $("[data-pe-shared-label]").textContent = `Use ${shared.fileName}`;
  }
  $("[data-pe-shared]").addEventListener("click", () => {
    const s2 = sharedRoster();
    if (s2) loadTable(s2.rows);
  });
  $("[data-pe-by]").addEventListener("change", () => {
    if (fileTable) loadTable(fileTable);
  });
  $<HTMLInputElement>("[data-pe-file]").addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = "";
    if (!file) return;
    const { readEmployeeFile, bestSheet, LoadError } = await import("../analytics/load");
    try {
      const loaded = await readEmployeeFile(file);
      loadTable(loaded.sheets[bestSheet(loaded.sheets)].rows as Cell[][]);
    } catch (err) {
      const msg = $("[data-paste-msg]");
      msg.hidden = false;
      msg.textContent = err instanceof LoadError ? err.message : "That file couldn't be read. Save it as CSV or Excel (.xlsx) and try again.";
    }
  });

  function renderRoles(a: Analysis) {
    const td = (text: string, cls = "") => Object.assign(document.createElement("td"), { textContent: text, className: cls });
    $("[data-role-rows]").replaceChildren(
      ...a.roles.map((r) => {
        const tr = document.createElement("tr");
        const th = Object.assign(document.createElement("th"), { scope: "row", textContent: r.role });
        const gap = r.gap === null ? "—" : Math.abs(r.gap) < 0.05 ? "0.0%" : `${pct(r.gap)} ${r.gap > 0 ? "lower" : "higher"}`;
        const note = !r.comparable ? (r.women ? "Only women" : r.men ? "Only men" : "No women or men") : r.small ? `Fewer than ${MIN_GROUP} ${r.women < MIN_GROUP && r.men < MIN_GROUP ? "of each" : r.women < MIN_GROUP ? "women" : "men"}` : "";
        tr.className = r.small || !r.comparable ? "is-small" : "";
        tr.append(th, td(String(r.women)), td(String(r.men)), td(r.meanWomen === null ? "—" : inr(r.meanWomen)), td(r.meanMen === null ? "—" : inr(r.meanMen)), td(gap, "gap"), td(note, "note"));
        return tr;
      })
    );
  }

  function renderRows() {
    $("[data-row-count]").textContent = rows.length ? `(${rows.length})` : "";
    const shown = rows.slice(0, SHOW_ROWS);
    $("[data-data-rows]").replaceChildren(
      ...shown.map((r, i) => {
        const tr = document.createElement("tr");
        const rm = Object.assign(document.createElement("button"), { type: "button", className: "rm", textContent: "Remove" });
        rm.setAttribute("aria-label", `Remove row ${i + 1}: ${r.role}, ${GENDER_LABEL[r.gender]}, ${inr(r.pay)}`);
        rm.addEventListener("click", () => {
          rows.splice(i, 1);
          commit();
        });
        const tdRm = document.createElement("td");
        tdRm.append(rm);
        tr.append(
          Object.assign(document.createElement("td"), { textContent: r.role }),
          Object.assign(document.createElement("td"), { textContent: GENDER_LABEL[r.gender] }),
          Object.assign(document.createElement("td"), { textContent: inr(r.pay), className: "num" }),
          tdRm
        );
        return tr;
      })
    );
    const limit = $("[data-row-limit]");
    limit.hidden = rows.length <= SHOW_ROWS;
    limit.textContent = `Showing the first ${SHOW_ROWS} of ${rows.length} rows. Every row is included in the results; download the CSV to see them all.`;
  }

  // Paste
  $("[data-paste-add]").addEventListener("click", () => {
    const ta = $<HTMLTextAreaElement>("#pe-paste");
    const r = parseRows(ta.value);
    const msg = $("[data-paste-msg]");
    rows.push(...r.rows);
    if (r.rows.length) commit();
    const head = r.rows.length ? `Added ${plural(r.rows.length, "row", "rows")}.` : r.errors.length ? "" : "Paste at least one row: role, gender, annual pay.";
    msg.replaceChildren(document.createTextNode(head));
    if (r.errors.length) {
      msg.append(Object.assign(document.createElement("p"), { textContent: `${plural(r.errors.length, "line wasn't", "lines weren't")} added. ${r.errors.length === 1 ? "It is" : "They are"} left in the box to fix:` }));
      const ul = document.createElement("ul");
      ul.append(...r.errors.slice(0, 8).map((e) => Object.assign(document.createElement("li"), { textContent: `Line ${e.line}: ${e.message}` })));
      msg.append(ul);
      ta.value = r.errors.map((e) => e.text).join("\n");
    } else ta.value = "";
    msg.classList.toggle("has-errors", r.errors.length > 0);
    msg.hidden = false;
  });

  // One person
  const one = $<HTMLFormElement>("[data-one]");
  one.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(one);
    const role = cleanRole(String(fd.get("role") ?? ""));
    const pay = parsePay(String(fd.get("pay") ?? ""));
    const gender = String(fd.get("gender")) as Gender;
    const err = $("[data-one-error]");
    if (!role || pay === null) {
      err.textContent = !role ? "Enter a role." : "Enter annual pay as a number, for example 8,40,000 or 8.4 lakh.";
      err.hidden = false;
      (one.querySelector<HTMLInputElement>(!role ? "#pe-role" : "#pe-pay"))!.focus();
      return;
    }
    err.hidden = true;
    rows.push({ role, gender, pay });
    one.querySelector<HTMLInputElement>("#pe-pay")!.value = "";
    commit();
    one.querySelector<HTMLInputElement>("#pe-pay")!.focus();
  });

  root.querySelectorAll("[data-example]").forEach((b) =>
    b.addEventListener("click", () => {
      if (rows.length && !window.confirm("Replace your rows with the example data?")) return;
      rows = EXAMPLE_ROWS.map((r) => ({ ...r }));
      commit();
    })
  );
  $("[data-csv]").addEventListener("click", () => {
    if (!rows.length) return;
    const blob = new Blob(["﻿" + toCsv(rows)], { type: "text/csv;charset=utf-8" });
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(blob), download: "pay-equity-data.csv" });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  $("[data-clear]").addEventListener("click", () => {
    if (!rows.length) return;
    if (!window.confirm(`Remove all ${rows.length} rows? This can't be undone.`)) return;
    rows = [];
    commit();
  });

  // Tooltips on the quarter bars
  const quart = $("[data-quart]");
  const tip = quart.querySelector<HTMLElement>(".tip")!;
  const show = (t: HTMLElement, x?: number) => {
    tip.textContent = t.dataset.tip ?? "";
    tip.hidden = false;
    const qb = quart.getBoundingClientRect();
    const tb = t.getBoundingClientRect();
    const cx = (x ?? tb.left + tb.width / 2) - qb.left;
    tip.style.left = `${Math.max(0, Math.min(qb.width - tip.offsetWidth, cx - tip.offsetWidth / 2))}px`;
    tip.style.top = `${tb.top - qb.top - tip.offsetHeight - 6}px`;
  };
  quart.addEventListener("pointermove", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
    if (t) show(t, e.clientX);
    else tip.hidden = true;
  });
  quart.addEventListener("pointerleave", () => (tip.hidden = true));
  quart.addEventListener("focusin", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
    if (t) show(t);
  });
  quart.addEventListener("focusout", () => (tip.hidden = true));

  render();
</script>

