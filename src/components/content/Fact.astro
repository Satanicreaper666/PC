---
import { factText, hasOfficialSource, stat } from "../../data/statutory";
/**
 * Inline statutory value from src/data/statutory.ts, with its source on hover:
 *   <Fact id="gratuity.ceiling" />        → ₹20 lakh
 *   <Fact id="epf.wageCeiling" short />   → ₹25,000 (without "a month")
 * Unverified values throw at build time (see factText).
 */
interface Props {
  id: string;
  short?: boolean;
}
const { id, short = false } = Astro.props;
const f = stat(id);
const text = factText(id, short ? "short" : "display");
const where = hasOfficialSource(f) ? "" : " Source: secondary (no official text found yet).";
---

<abbr class="fact" title={`${f.label}. ${f.law}. Checked ${f.checked}.${where}`}>{text}</abbr>

<style>
  .fact {
    text-decoration: underline dotted var(--neel-400);
    text-underline-offset: 3px;
    cursor: help;
    font-weight: 620;
  }
</style>
