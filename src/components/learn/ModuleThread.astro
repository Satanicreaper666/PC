---
/**
 * Where a module sits in the course: the six blocks as six weft threads, each module a
 * numbered knot on its block's thread, the current module the turmeric knot. Every
 * published module is a link; one not yet published is a dashed knot, and not a link.
 * Under it, the modules either side by name. The Learn echo of BookThread.
 *
 * <ModuleThread modules={[{ n: 1, title: "…", block: "foundations", href: "/learn/…/" }, …]} current={2} />
 * Leave out `current` (on a guide) and it is simply the map of the course.
 *
 * If the reader's desk records modules as read (src/scripts/desk.ts), those knots fill in.
 */
import Weave from "../ui/Weave.astro";
import { LEARN_BLOCKS, type LearnBlockId } from "../../data/learn";
type Mod = { n: number; title: string; block: LearnBlockId; href?: string };
interface Props {
  modules: Mod[];
  current?: number;
  /** The course home. */
  homeHref?: string;
}
const { modules, current, homeHref = "/learn/" } = Astro.props;
const SHORT: Record<LearnBlockId, string> = {
  foundations: "Foundations",
  core: "HR functions",
  relations: "Relations and law",
  strategy: "Strategic HR",
  frontier: "The frontier",
  credentials: "Credentials"
};
const sorted = [...modules].sort((a, b) => a.n - b.n);
const blockIds = (Object.keys(LEARN_BLOCKS) as LearnBlockId[]).filter((b) => sorted.some((m) => m.block === b));
const here = sorted.find((m) => m.n === current);
const published = sorted.filter((m) => m.href || m.n === current);
const at = published.findIndex((m) => m.n === current);
const prev = at > 0 ? published[at - 1] : undefined;
const next = at >= 0 ? published[at + 1] : undefined;
---

<div role="note" class="mt" aria-label={here ? "Where this module sits in the course" : "The modules of PeopleCraft Learn"} data-module-thread>
  <div class="mt-head">
    <span class="mt-swatch" aria-hidden="true">
      <Weave structure="plain" cols={5} rows={6} cell={20} warp="#3B44A6" weft="#6B76D2" gap="#11143A" accent="#EFAB22" accentCols={[2]} />
    </span>
    <div>
      <a class="mt-course" href={homeHref}>PeopleCraft Learn</a>
      <p class="mt-of">
        {here ? `Module ${here.n} of ${sorted.length}` : `${sorted.length} modules in ${blockIds.length} blocks`}
        <span class="mt-count" data-mt-count hidden></span>
      </p>
    </div>
  </div>

  <ol class="mt-blocks" role="list">
    {
      blockIds.map((b) => {
        const mods = sorted.filter((m) => m.block === b);
        return (
          <li class:list={["mt-block", { "is-here": here?.block === b }]}>
            <span class="mt-bl">
              <span class="mt-letter" aria-hidden="true">
                {LEARN_BLOCKS[b].letter}
              </span>
              <span class="mt-bname">
                <span class="visually-hidden">Block {LEARN_BLOCKS[b].letter}: </span>
                {SHORT[b]}
              </span>
            </span>
            <ol class="mt-knots" role="list" style={`--n:${mods.length}`}>
              {mods.map((m) => {
                const cur = m.n === current;
                const name = `Module ${m.n}: ${m.title}`;
                return (
                  <li class:list={["mt-k", { cur, soon: !m.href && !cur }]} data-mt-href={m.href}>
                    {m.href || cur ? (
                      <a href={m.href} aria-label={cur ? `${name} (this module)` : name} aria-current={cur ? "page" : undefined} title={m.title}>
                        <span class="mt-knot" aria-hidden="true">
                          {m.n}
                        </span>
                      </a>
                    ) : (
                      <span class="mt-nolink">
                        <span class="mt-knot" aria-hidden="true">
                          {m.n}
                        </span>
                        <span class="visually-hidden">{name} (coming soon)</span>
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
          </li>
        );
      })
    }
  </ol>

  {
    (prev || next) && (
      <dl class="mt-near">
        {prev && (
          <div>
            <dt>Before</dt>
            <dd>
              <a href={prev.href}>{prev.title}</a>
            </dd>
          </div>
        )}
        {next && (
          <div>
            <dt>Next</dt>
            <dd>
              <a href={next.href}>{next.title}</a>
            </dd>
          </div>
        )}
      </dl>
    )
  }
</div>

<script>
  import { getRead, DESK_CHANGE } from "../../scripts/desk";

  // Fill in the knots of modules the desk has recorded as read, if it records any.
  function paint(root: HTMLElement) {
    const read = getRead();
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-mt-href]"));
    let n = 0;
    items.forEach((li) => {
      const isRead = !!read[li.dataset.mtHref ?? ""];
      li.classList.toggle("read", isRead);
      if (isRead) n++;
      const a = li.querySelector("a");
      if (a) {
        const label = (a.dataset.label ??= a.getAttribute("aria-label") ?? "");
        a.setAttribute("aria-label", isRead ? `${label} (read)` : label);
      }
    });
    const count = root.querySelector<HTMLElement>("[data-mt-count]");
    if (count) {
      count.hidden = n === 0;
      count.textContent = n ? ` · ${n} read` : "";
    }
  }
  const threads = document.querySelectorAll<HTMLElement>("[data-module-thread]");
  threads.forEach(paint);
  window.addEventListener(DESK_CHANGE, (e) => {
    const what = (e as CustomEvent<{ what?: string }>).detail?.what;
    if (what === "read" || what === "all") threads.forEach(paint);
  });
</script>

<style>
  .mt {
    display: grid;
    gap: 1rem;
  }
  .mt-head {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
  }
  .mt-swatch {
    display: block;
    width: 2.6rem;
    aspect-ratio: 3 / 4;
    border-radius: 3px 7px 7px 3px;
    overflow: hidden;
    box-shadow:
      1px 1.5px 0 rgb(17 20 58 / 0.2),
      3px 6px 10px -4px rgb(17 20 58 / 0.4);
  }
  .mt-course {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.25;
  }
  .mt-course:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mt-of {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  .mt-count {
    color: var(--ink-2);
  }
  .mt-blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .mt-block {
    display: grid;
    grid-template-columns: 8.1rem minmax(0, 1fr);
    gap: 0.4rem;
    align-items: center;
  }
  .mt-bl {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.2;
  }
  .mt-letter {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
    border-radius: 4px;
    background: var(--paper);
    color: var(--neel-700);
    font-weight: 750;
    font-size: 0.75rem;
    box-shadow: 0 0 0 1px rgb(17 20 58 / 0.14);
  }
  .is-here .mt-bl {
    color: var(--ink);
    font-weight: 700;
  }
  .is-here .mt-letter {
    background: var(--neel-700);
    color: #fff;
    box-shadow: none;
  }
  /* One weft thread per block, spun like yarn; the block you're in is a shade darker. */
  .mt-knots {
    position: relative;
    justify-self: start;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .mt-knots::before {
    content: "";
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    top: calc(50% - 2.5px);
    height: 5px;
    border-radius: 3px;
    background: repeating-linear-gradient(115deg, var(--neel-200) 0 3px, var(--neel-100) 3px 6px);
  }
  .is-here .mt-knots::before {
    background: repeating-linear-gradient(115deg, var(--neel-400) 0 3px, var(--neel-300) 3px 6px);
  }
  .mt-k {
    position: relative;
    display: grid;
    place-items: center;
  }
  .mt-k a,
  .mt-nolink {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 2.1rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .mt-knot {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid var(--neel-600);
    background: var(--paper);
    color: var(--neel-800);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 2px var(--canvas);
    transition: transform 160ms var(--ease-out);
  }
  .mt-k a:hover .mt-knot {
    transform: translateY(-1.5px);
    background: var(--neel-50);
  }
  .mt-k a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .soon .mt-knot {
    border: 1.5px dashed #8a8fa6;
    color: var(--ink-3);
    background: var(--canvas);
  }
  .read .mt-knot {
    background: var(--neel-500);
    border-color: var(--neel-500);
    color: #fff;
  }
  .cur .mt-knot {
    width: 2rem;
    height: 2rem;
    background: var(--accent);
    border-color: var(--haldi-700);
    color: var(--neel-950);
    font-size: var(--fs-xs);
    font-weight: 780;
    box-shadow:
      0 0 0 2px var(--canvas),
      1.5px 2.5px 0 2px rgb(17 20 58 / 0.1);
  }
  .cur a {
    width: 2.1rem;
  }
  .cur a:hover .mt-knot {
    transform: none;
  }
  .mt-near {
    margin: 0.2rem 0 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--fs-sm);
  }
  .mt-near div {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }
  .mt-near dt {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--ink-3);
  }
  .mt-near dd {
    margin: 0;
  }
  .mt-near a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.3;
  }
  .mt-near a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 22rem) {
    .mt-block {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
