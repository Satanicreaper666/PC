---
/**
 * "Where to start": a two-minute self-check. One task per block of the course;
 * the reader says how confident they are with each, and src/scripts/learn-start.ts
 * recommends the first module of the block they feel least sure of (or Module 1
 * when the answers are even). It also moves the start knot on the CourseMap.
 *
 * Nothing is stored or sent: the answers live in the page and go when it closes.
 * There is no form to submit. Without JavaScript the questions still show, with a
 * note to start at Module 1.
 */
import { coursePlan } from "../../lib/learn";
import type { LearnBlockId } from "../../data/learn";

interface Props {
  /** Anchor prefix of the CourseMap on the same page, for "See it on the course map". */
  mapPrefix?: string;
}
const { mapPrefix = "" } = Astro.props;
const plan = await coursePlan();

/** One task per block, each the kind of work its block assignment asks for (research/08). */
const TASKS: Record<LearnBlockId, string> = {
  foundations: "I can read a P&L and build a costed business case for an HR idea.",
  core: "I can review an HR process, such as hiring or appraisal, against evidence and fix what isn't working.",
  relations: "I can check a site's compliance with the Labour Codes and handle a disciplinary case fairly.",
  strategy: "I can write an HR strategy on one page that links people plans to the business plan.",
  frontier: "I can write a policy for using AI in HR that covers fairness, privacy and who decides.",
  credentials: "I can answer SHRM-style judgement questions and write a CIPD-style assignment to a brief."
};
const SCALE = ["Not yet", "With help", "Confidently"] as const;

/* What the script needs, as data: blocks in order, each module's number, title, link and whether it's ready. */
const data = {
  mapPrefix,
  blocks: plan.map((b) => ({
    id: b.id,
    letter: b.letter,
    title: b.title,
    modules: b.modules.map((m) => ({ n: m.n, title: m.title, href: m.href, ready: m.ready }))
  }))
};
---

<div class="ws" data-ws>
  <script type="application/json" data-ws-data set:html={JSON.stringify(data)} />
  <ol class="ws-qs" role="list">
    {
      plan.map((b, i) => (
        <li class="ws-q">
          <div class="ws-row" role="radiogroup" aria-labelledby={`ws-t-${b.id}`} aria-describedby={`ws-b-${b.id}`}>
            <p class="ws-text">
              <span class="ws-block" id={`ws-b-${b.id}`}>
                Block {b.letter}, {b.title}
              </span>
              <span class="ws-task" id={`ws-t-${b.id}`}>{TASKS[b.id]}</span>
            </p>
            <div class="ws-opts">
              {SCALE.map((s, v) => (
                <label class="ws-opt">
                  <input type="radio" name={`ws-${b.id}`} value={v} data-ws-block={b.id} data-ws-i={i} />
                  <span>{s}</span>
                </label>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <noscript>
    <p class="ws-nojs">
      This check works out its answer in your browser, which needs JavaScript. Without it, start at Module 1: the course builds in order, and each module says
      what it assumes you know.
    </p>
  </noscript>

  <div class="ws-out" data-ws-out hidden>
    <p class="ws-progress" data-ws-progress>0 of {plan.length} answered</p>
    <div class="ws-result" data-ws-result aria-live="polite">
      <p class="ws-wait">Answer all {plan.length} to see where to start. If you'd rather not, start at Module 1: the course builds in order.</p>
    </div>
    <button type="button" class="btn btn-ghost btn-sm ws-reset" data-ws-reset hidden>Start the check again</button>
  </div>
</div>

<script>
  import "../../scripts/learn-start";
</script>

<style>
  /* The questions on the left; the answer beside them, staying in view while you answer. */
  .ws {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem);
    align-items: start;
    gap: 1.5rem 3rem;
  }
  .ws > noscript,
  .ws-out {
    grid-column: 2;
    grid-row: 1;
  }
  .ws-out {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .ws-qs {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: q;
    border-top: 2px solid var(--neel-700);
  }
  .ws-q {
    counter-increment: q;
    border-bottom: 1px solid var(--line);
  }
  .ws-row {
    padding: 1rem 0 1.1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .ws-text {
    display: grid;
    gap: 0.2rem;
  }
  .ws-block {
    font-size: var(--fs-xs);
    font-weight: 650;
    color: var(--ink-3);
  }
  .ws-task {
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }
  .ws-task::before {
    content: counter(q) ". ";
    content: counter(q) ". " / "";
    color: var(--neel-500);
    font-weight: 700;
  }
  /* Three answers as a row of paper tabs; the chosen one is inked in. */
  .ws-opts {
    display: inline-flex;
    gap: 0;
    border-radius: var(--r);
    /* A 3:1 edge, so the row reads as one control against the page. */
    box-shadow: 0 0 0 1.5px #7d83a1;
    background: var(--paper);
  }
  .ws-opt {
    position: relative;
    display: block;
  }
  .ws-opt + .ws-opt span {
    border-left: 1.5px solid #7d83a1;
  }
  .ws-opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .ws-opt span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
    transition: background-color 150ms, color 150ms;
  }
  .ws-opt:first-child span {
    border-radius: var(--r) 0 0 var(--r);
  }
  .ws-opt:last-child span {
    border-radius: 0 var(--r) var(--r) 0;
  }
  .ws-opt input:hover + span {
    background: var(--neel-50);
    color: var(--ink);
  }
  .ws-opt input:checked + span {
    background: var(--neel-700);
    color: #fff;
  }
  /* A tick as well as the ink, so the choice never rests on colour alone. */
  .ws-opt input:checked + span::before {
    content: "";
    display: inline-block;
    width: 0.35rem;
    height: 0.65rem;
    margin-right: 0.45rem;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: translateY(-0.1rem) rotate(40deg);
  }
  .ws-opt span {
    grid-auto-flow: column;
  }
  .ws-opt input:focus-visible + span {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
    position: relative;
    z-index: 1;
  }
  .ws-nojs {
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
  }
  .ws-out {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .ws-progress {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  /* The answer: a sticky note, a tip to act on. */
  .ws-result {
    --note: #fff3a6;
    width: 100%;
    padding: 1.2rem 1.35rem 1.25rem;
    border-radius: 2px 2px 3px 14px / 2px 2px 3px 6px;
    background:
      linear-gradient(170deg, rgb(255 255 255 / 0.35), transparent 40%),
      var(--note);
    box-shadow:
      0 1px 1px rgb(17 20 58 / 0.08),
      3px 8px 14px -6px rgb(17 20 58 / 0.28),
      inset 0 -2px 0 #f2df6f;
    transform: rotate(-0.35deg);
  }
  .ws-result:has(.ws-wait) {
    --note: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--line);
    transform: none;
  }
  .ws-wait {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .ws-result :global(.ws-k) {
    font-size: 1.6rem;
    line-height: 1;
  }
  .ws-result :global(.ws-pick) {
    margin-top: 0.45rem;
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .ws-result :global(.ws-pick a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgb(21 26 59 / 0.35);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ws-result :global(.ws-pick a:hover) {
    text-decoration-color: currentColor;
  }
  .ws-result :global(.ws-why),
  .ws-result :global(.ws-alt) {
    margin-top: 0.55rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink);
  }
  .ws-result :global(.ws-alt a),
  .ws-result :global(.ws-map) {
    color: var(--neel-800);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ws-result :global(.ws-map) {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--fs-sm);
  }
  @media (max-width: 960px) {
    .ws {
      grid-template-columns: 1fr;
    }
    .ws > noscript,
    .ws-out {
      grid-column: 1;
      grid-row: auto;
      position: static;
    }
  }
  @media (max-width: 720px) {
    .ws-row {
      grid-template-columns: 1fr;
    }
    .ws-opts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ws-opt span {
      padding: 0 0.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ws-opt span {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .ws-opts {
      border: 1px solid CanvasText;
    }
    .ws-opt input:checked + span {
      background: Highlight;
      color: HighlightText;
    }
  }
</style>
